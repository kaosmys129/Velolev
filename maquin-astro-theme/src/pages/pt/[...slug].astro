---
import LocalizedRoute from "../../components/procurement/LocalizedRoute.astro";
import {industrialStaticPaths,localizedPagePath} from "../../lib/site-config.mjs";
export function getStaticPaths(){return industrialStaticPaths("pt");}
const {page}=Astro.props;
const target=localizedPagePath(page,"pt");
if(Astro.url.pathname!==target)return Astro.redirect(target,301);
---
<LocalizedRoute page={page} locale="pt"/>
