---
import ProcurementLayout from "../../layouts/ProcurementLayout.astro";
import FlangeChecker from "../../components/procurement/FlangeChecker.astro";
import baseline from "../../data/content-baseline.json";
import {configurationVariants} from "../../data/configurations-content.mjs";
import {publicOrigin} from "../../lib/site-config.mjs";
import {faqSchema} from "../../utils/contentPolicy.mjs";

export function getStaticPaths(){
  return configurationVariants.map(variant=>({
    params:{slug:variant.slug},
    props:{variant}
  }));
}

const {variant}=Astro.props;
const origin=publicOrigin();
const parentProductId=origin?`${origin}/products/light-pole-jack/#product`:"/products/light-pole-jack/#product";
const variantProductId=origin?`${origin}${variant.path}#product`:`${variant.path}#product`;
const imageUrl=origin?new URL("/images/product/portable-pole-lifter-hero-cutout.png",origin).href:"/images/product/portable-pole-lifter-hero-cutout.png";

/**
 * 变体页 Product JSON-LD：通过 isVariantOf 锚定唯一母产品实体，
 * 严格遵守零报价、零库存状态与单物理主机商业政策。
 */
const variantProductSchema={
  "@context":"https://schema.org",
  "@type":"Product",
  "@id":variantProductId,
  name:variant.h1,
  alternateName:baseline.product.categoryAliases,
  description:variant.description,
  image:[imageUrl],
  brand:{"@type":"Brand",name:baseline.brand.name},
  category:"Portable hydraulic light pole lifting equipment",
  isVariantOf:{"@id":parentProductId},
  additionalProperty:variant.rows.map(([name,value,note])=>({
    "@type":"PropertyValue",
    name,
    value:`${value} (${note})`
  }))
};

const variantFaqSchema=faqSchema(variant.faqs);

const breadcrumbs=[
  {name:"Home",path:"/"},
  {name:"The equipment",path:"/products/light-pole-jack/"},
  {name:variant.shortTitle,path:variant.path}
];
---
<ProcurementLayout
  page="configuration"
  locale="en"
  title={variant.title}
  description={variant.description}
  canonicalPath={variant.path}
  alternates={[{lang:"en",path:variant.path}]}
  breadcrumbs={breadcrumbs}
  extraSchemas={[variantProductSchema,variantFaqSchema]}
>
  <main id="main">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Home</a> / <a href="/products/light-pole-jack/">The equipment</a> / {variant.shortTitle}</p>
      <section class="config-hero">
        <p class="eyebrow">{variant.eyebrow}</p>
        <h1>{variant.h1}</h1>
        <p class="lead muted">{variant.lead}</p>
        <ul class="config-pills">
          {variant.highlights.map(item=><li>{item}</li>)}
        </ul>
        <div class="actions">
          <a class="button" href={variant.quoteHref}>{variant.quoteLabel} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/products/light-pole-jack/">View base equipment specifications →</a>
        </div>
      </section>

      <section class="evidence-panel" data-source-id="S4" data-baseline-version={baseline.version}>
        <p class="eyebrow">01 / Direct specification summary</p>
        <p>{variant.directAnswer}</p>
      </section>
    </div>

    <section class="section" data-source-id="S4" data-baseline-version={baseline.version}>
      <div class="wrap two-column">
        <div>
          <p class="eyebrow">02 / Specification &amp; boundary matrix</p>
          <h2>{variant.tableHeading}</h2>
          <p class="muted" style="margin-top:22px">{variant.tableIntro}</p>
          <p class="note">Source baseline {baseline.version} (S4). Non-standard bases require a dimensioned drawing review.</p>
        </div>
        <div class="table-scroll">
          <table class="technical-table">
            <thead>
              <tr>
                <th scope="col">Parameter</th>
                <th scope="col">Specification value</th>
                <th scope="col">Review boundary</th>
              </tr>
            </thead>
            <tbody>
              {variant.rows.map(([param,val,boundary])=>(
                <tr>
                  <th scope="row">{param}</th>
                  <td>{val}</td>
                  <td>{boundary}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {variant.checker?.enabled ? (
      <div class="wrap">
        <FlangeChecker
          locale="en"
          id={variant.checker.id}
          defaultSpan={variant.checker.defaultSpan}
          defaultBolt={variant.checker.defaultBolt}
          defaultHoles={variant.checker.defaultHoles}
        />
      </div>
    ) : (
      <section class="section" style="padding-top:0">
        <div class="wrap evidence-panel">
          <p class="eyebrow">03 / Pre-inquiry project checklist</p>
          <h2>{variant.checklistHeading}</h2>
          <ul class="config-checklist">
            {variant.checklistItems.map(item=><li>{item}</li>)}
          </ul>
          <div class="actions" style="margin-top:24px">
            <a class="button" href={variant.quoteHref}>{variant.quoteLabel} <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="/resources/">Download specification summary &amp; worksheet →</a>
          </div>
        </div>
      </section>
    )}

    <section class="section" id="configuration-faq">
      <div class="wrap two-column">
        <div>
          <p class="eyebrow">04 / Configuration questions</p>
          <h2>Selection boundaries.<br/>Clear answers.</h2>
          <p class="muted" style="margin-top:22px">Every answer reflects the confirmed S4 specification sheet and engineering review boundaries. Non-standard bases require a dimensioned drawing review.</p>
        </div>
        <div>
          {variant.faqs.map(([question,answer],i)=>(
            <details class="faq-item" open={i===0}>
              <summary><span class="kicker">{String(i+1).padStart(2,"0")}</span>{question}<span aria-hidden="true">＋</span></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <p class="eyebrow">05 / Related configurations &amp; guides</p>
        <div class="guide-grid" style="margin-top:24px">
          {variant.relatedLinks.map(link=>(
            <a class="guide-card" href={link.href}>
              <h3>{link.label}</h3>
              <span class="text-link">Open reference ↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</ProcurementLayout>
<style>
.config-hero{padding:24px 0 42px}.config-hero h1{margin-top:14px}.config-hero .lead{max-width:68ch;margin-top:18px}.config-pills{list-style:none;padding:0;margin:24px 0 0;display:flex;flex-wrap:wrap;gap:10px}.config-pills li{border:1px solid var(--line);background:var(--white);padding:8px 14px;font:12px 'Courier New',monospace;color:var(--ink)}.config-checklist{margin:20px 0 0;padding-left:20px;display:grid;gap:12px;max-width:72ch}
</style>
