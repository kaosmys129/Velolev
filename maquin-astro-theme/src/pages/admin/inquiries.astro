<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>velolev 询盘收件箱</title><link rel="icon" href="/brand/velolev-wordmark.svg"/>
<style>body{font:14px/1.6 system-ui,sans-serif;margin:0;color:#1d2920;background:#f3f2ec}main{max-width:1280px;margin:auto;padding:35px 24px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #cbd2c4;padding-bottom:22px}h1{font-size:28px;margin:0}h2{margin-top:0}a{color:inherit}button,input,select{font:inherit;padding:10px 14px;border:1px solid #b6c1ae;border-radius:3px;background:#fff}button{cursor:pointer}button:disabled{opacity:.5;cursor:wait}.primary{background:#f4cc3d;border-color:#f4cc3d;color:#16281a}label{display:block}#login{max-width:570px;margin:55px 0;padding:30px;background:#e5e9dc}#login input{display:block;width:100%;box-sizing:border-box;margin:12px 0 18px}.hint{color:#5f6e5c;font-size:12px}.toolbar{display:flex;gap:14px;align-items:center;margin:25px 0;flex-wrap:wrap}.toolbar label{display:flex;gap:8px;align-items:center}.toolbar input{width:18px;height:18px}.table-scroll{overflow:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{text-align:left;border-bottom:1px solid #cbd2c4;padding:13px 10px;white-space:nowrap}th{background:#e5e9dc}td button{border:0;background:none;padding:0;text-decoration:underline;color:#345134}.workspace{display:grid;grid-template-columns:1.2fr 1fr;gap:25px}.detail{background:#fff;padding:25px;overflow-wrap:anywhere;align-self:start}dl{display:grid;grid-template-columns:95px 1fr;gap:12px;margin:0 0 25px}dt{color:#6a7665}dd{margin:0;white-space:pre-wrap}.badge{display:inline-block;padding:2px 7px;background:#e9deae;margin-left:6px;font-size:11px}.message{min-height:25px;color:#a33c22;white-space:pre-wrap}.pager{display:flex;align-items:center;gap:15px;margin-top:22px}[hidden]{display:none!important}@media(max-width:950px){.workspace{grid-template-columns:1fr}}@media(max-width:550px){main{padding:25px 14px}header{align-items:start;gap:20px}h1{font-size:23px}dl{grid-template-columns:75px 1fr}}</style>
</head><body><main><header><div><p class="hint">velolev / PRIVATE INBOX</p><h1>项目询盘收件箱</h1></div><a href="/">返回网站 ↗</a></header><section id="login"><h2>使用私有管理密钥登录</h2><p>密钥保存在服务端配置或本机的私有数据目录中。它不会写入页面地址或浏览器持久存储。</p><form id="login-form"><label for="admin-key">管理密钥<input id="admin-key" type="password" autocomplete="off" required minlength="32"/></label><button class="primary" type="submit">打开收件箱</button></form><p class="hint">本地默认密钥文件：.local/inquiries/admin-token。勿公开或提交到版本库。</p></section><p id="message" class="message" role="status" aria-live="polite"></p><section id="inbox" hidden><div class="toolbar"><button id="refresh">刷新</button><button id="export">导出 CSV</button><label><input type="checkbox" id="include-tests"/>包含测试询盘</label><span id="total"></span><button id="logout" style="margin-left:auto">退出</button></div><div class="workspace"><div><div class="table-scroll"><table><thead><tr><th>编号</th><th>联系人</th><th>目的地</th><th>状态</th></tr></thead><tbody id="rows"></tbody></table></div><div class="pager"><button id="previous">上一页</button><span id="page-number"></span><button id="next">下一页</button></div></div><article id="detail" class="detail" hidden></article></div></section></main>
<script>
 let key="",offset=0,total=0;
 const byId=(id:string)=>document.getElementById(id)!;
 const message=(text:string)=>byId("message").textContent=text;
 const testQuery=()=> (byId("include-tests") as HTMLInputElement).checked?"1":"0";
 async function request(path:string,init:RequestInit={}){const response=await fetch(path,{...init,headers:{...init.headers,"Authorization":`Bearer ${key}`}});if(!response.ok){let msg="无法完成操作。";try{const data=await response.json();msg=data.error?.message??msg;}catch{}throw new Error(msg);}return response;}
 function element(tag:string,text:string){const n=document.createElement(tag);n.textContent=text;return n;}
 async function refresh(){message("");try{const data=await(await request(`/api/admin/inquiries?offset=${offset}&includeTests=${testQuery()}`)).json();total=data.total;byId("total").textContent=`${total} 条记录`;const rows=byId("rows");rows.replaceChildren();for(const item of data.items){const row=document.createElement("tr"),ref=document.createElement("td"),button=document.createElement("button");button.type="button";button.textContent=item.reference;button.addEventListener("click",()=>show(item.id));ref.append(button);if(item.isTest){const badge=element("span","测试");badge.className="badge";ref.append(badge);}row.append(ref,element("td",item.name),element("td",item.country),element("td",item.status));rows.append(row);}byId("page-number").textContent=`${Math.floor(offset/30)+1} / ${Math.max(1,Math.ceil(total/30))}`;(byId("previous") as HTMLButtonElement).disabled=offset===0;(byId("next") as HTMLButtonElement).disabled=offset+30>=total;}catch(e){message((e as Error).message);}}
 async function download(path:string,name:string){try{const response=await request(path),blob=await response.blob(),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}catch(e){message((e as Error).message);}}
 async function show(id:string){try{const {item}=await(await request(`/api/admin/inquiries/${id}`)).json(),panel=byId("detail");panel.hidden=false;panel.replaceChildren(element("h2",item.reference));if(item.isTest)panel.append(element("p","测试记录，不计入经营询盘。"));const dl=document.createElement("dl");for(const [label,value] of [["收件时间",item.createdAt],["姓名",item.name],["公司",item.company],["邮箱",item.email],["电话",item.phone],["目的地",item.country],["用途",item.inquiryType],["应用",item.application],["数量",item.quantity],["杆高(m)",item.poleHeight],["总重(kg)",item.poleWeight],["基础资料",item.foundation],["项目说明",item.message],["来源页",item.sourcePage],["语言",item.locale]]){dl.append(element("dt",label),element("dd",String(value||"—")));}panel.append(dl);if(item.attachment){const file=element("button",`下载附件：${item.attachment.name}`);file.addEventListener("click",()=>download(`/api/admin/inquiries/${id}/attachment`,item.attachment.name));panel.append(file);}const label=element("label","处理状态"),select=document.createElement("select");select.style.margin="20px 12px 0 0";for(const value of ["new","in_review","quoted","closed"]){const option=document.createElement("option");option.value=value;option.textContent=value;option.selected=value===item.status;select.append(option);}const save=element("button","保存状态");save.addEventListener("click",async()=>{try{await request(`/api/admin/inquiries/${id}`,{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:select.value})});await refresh();message("状态已保存。");}catch(e){message((e as Error).message);}});label.append(select);panel.append(label,save);}catch(e){message((e as Error).message);}}
 byId("login-form").addEventListener("submit",async e=>{e.preventDefault();key=(byId("admin-key") as HTMLInputElement).value.trim();try{await request("/api/admin/inquiries?limit=1");byId("login").hidden=true;byId("inbox").hidden=false;(byId("admin-key") as HTMLInputElement).value="";await refresh();}catch(e){key="";message((e as Error).message);}});
 byId("refresh").addEventListener("click",refresh);byId("include-tests").addEventListener("change",()=>{offset=0;refresh();});byId("previous").addEventListener("click",()=>{offset=Math.max(0,offset-30);refresh();});byId("next").addEventListener("click",()=>{offset+=30;refresh();});byId("export").addEventListener("click",()=>download(`/api/admin/inquiries.csv?includeTests=${testQuery()}`,"velolev-inquiries.csv"));byId("logout").addEventListener("click",()=>{key="";byId("rows").replaceChildren();byId("detail").replaceChildren();byId("detail").hidden=true;byId("inbox").hidden=true;byId("login").hidden=false;message("");});
</script></body></html>
