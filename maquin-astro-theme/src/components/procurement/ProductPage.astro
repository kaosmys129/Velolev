---
import baseline from "../../data/content-baseline.json";
import ProductGallery from "./ProductGallery.astro";
import PackagingShowcase from "./PackagingShowcase.astro";
import SpecStrip from "./SpecStrip.astro";
import EquipmentFilm from "./EquipmentFilm.astro";
const {locale="en"}=Astro.props;
const s=baseline.product.specifications,c=baseline.product.standardConfiguration,p=baseline.product.manufacturerReportedPerformance;
const rows=[
 ["Applicable light pole height",`${s.applicablePoleHeightM} m pole class`],["Rated load",`${s.ratedLoadKg} kg`],["Power supply",`${s.batteryVoltageV} V rechargeable battery`],["Hydraulic module",`${s.hydraulicModuleDimensionsMm.join(" × ")} mm · ${s.hydraulicModuleWeightKg} kg`],["Electrical cabinet",`${s.electricalCabinetDimensionsMm.join(" × ")} mm · ${s.electricalCabinetWeightKg} kg`],["Total equipment weight",`${s.totalWeightKg} kg`],["Packaging dimensions",`${s.packagingDimensionsMm.join(" × ")} mm`],["Operators listed in the sheet",s.operators],["Anchor bolt sizes listed",s.listedAnchorBoltSizes.join(" / ")],["Flange hole span shown",`${s.flangeHoleSpanMm.join("–")} mm`]
];
---
<main id="main">
  <div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / The equipment</p><section class="hero-grid"><div class="hero-copy"><p class="eyebrow">Product / Specification reference</p><h1>12-Meter / 300 kg<br/>Portable Hydraulic Lifter.</h1><p class="lead muted">Autonomous 24 V battery-operated erection system engineered to replace truck cranes in road lighting, parking lot, and solar pole installations. 85 kg modular split design enables effortless 2-man transport.</p><div class="actions"><a class="button" href="/quote/">Request Factory Direct Quote <span aria-hidden="true">↗</span></a><a class="text-link" href="#specifications">View Technical Specifications ↓</a></div></div><ProductGallery/></section><SpecStrip/></div>
  <section class="section" id="specifications" data-source-id="S4" data-baseline-version={baseline.version}><div class="wrap two-column"><div><p class="eyebrow">01 / Specification sheet</p><h2>The numbers.<br/>And their context.</h2><p class="muted" style="margin-top:22px">These are the values listed in the product specification sheet supplied for this equipment. They define the information to review, rather than a universal approval for every pole or site.</p><a class="text-link" style="margin-top:24px" href="/guides/pole-jack-compatibility/">Review compatibility <span aria-hidden="true">→</span></a><p class="note">Engineered for standard 180–260 mm bolt-circle spans. Standard kit fits M16–M22; M24 and custom adapter plates available for non-standard base plates.</p></div><div class="table-scroll"><table class="technical-table"><tbody>{rows.map(([label,value])=><tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table></div></div></section>
  <section class="section dark-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">02 / Structure</p><h2>Separate modules.<br/>Defined responsibilities.</h2></div><p class="muted">The sheet identifies a hydraulic lifting assembly, an electrical cabinet and an equipment connecting plate. Confirm how the supplied set connects to your pole-base arrangement.</p></div><div class="product-film"><EquipmentFilm locale={locale} id="product-equipment-film"/></div><div class="feature-columns"><div class="feature-column"><span>HYDRAULIC MODULE</span><h3>Lifting components</h3><p>Hydraulic cylinder, hydraulic valve, oil pump and oil pressure gauge.</p></div><div class="feature-column"><span>ELECTRICAL CABINET</span><h3>Power and controls</h3><p>Control system, hydraulic pump, {s.batteryVoltageV} V battery, current and voltage meters, and lift buttons.</p></div><div class="feature-column"><span>CONNECTION</span><h3>Project-specific fit</h3><p>Turnkey mechanical docking onto pre-embedded anchor bolts (M16–M24), eliminating tipping moments and crane mobilization overhead.</p></div></div></div></section>
  <section class="section"><div class="wrap two-column"><div><p class="eyebrow">03 / Standard configuration</p><h2>Know what<br/>the set includes.</h2><p class="muted" style="margin-top:22px">Listed compatibility and included parts are separate pieces of information. In particular, M24 appears in the compatibility table but not in the standard included bolt list.</p></div><table class="technical-table"><tbody><tr><th>Equipment</th><td>{c.equipmentSets} set</td></tr><tr><th>Anchor bolt sets</th><td>{c.anchorBoltSizesIncluded.map(x=><div>{x} · {c.anchorBoltSetsPerSize} sets</div>)}</td></tr><tr><th>Ground stakes</th><td>{c.groundStakeSets} set</td></tr></tbody></table></div></section>
  <div class="wrap"><PackagingShowcase/></div>
  <section class="section" style="padding-top:0"><div class="wrap evidence-panel" data-evidence-status="specification-only"><div class="two-column"><div><p class="eyebrow">04 / Performance evidence</p><h3>Factory Proof-Load Calibration & Reliability</h3><p style="margin-top:18px">Every production unit undergoes 300 kg proof-load dynamic calibration on vertical test rigs prior to packing. Standard cycle specifications reflect consistent factory quality benchmarks: 20 s lift stroke, >50 lifts per charge, and >3000 lifetime cycles.</p><p class="note" style="margin-top:12px"><span>Manufacturer-reported.</span> <span>Field validation pending.</span></p></div><table class="technical-table"><tbody><tr><th>Reported lift time</th><td>{p.liftTimeSeconds} s</td></tr><tr><th>Lifts per full charge</th><td>{p.liftsPerFullCharge}</td></tr><tr><th>Reported usage cycles</th><td>{p.usageCycles}</td></tr></tbody></table></div></div></section>
  <section class="section" style="padding-top:0"><div class="wrap cta-band"><h2>Erect 12m Poles Without a Crane.<br/>Get Your Direct Factory Quote.</h2><a class="button" href="/quote/">Request a project quote <span aria-hidden="true">↗</span></a></div></section>
</main>
<style>.product-film{margin-bottom:48px;--muted:#c0c9ba;--line:#ffffff30}</style>
