---
import baseline from "../../data/content-baseline.json";
import {productFaq} from "../../data/decision-content.mjs";
import ProductGallery from "./ProductGallery.astro";
import PackagingShowcase from "./PackagingShowcase.astro";
import SpecStrip from "./SpecStrip.astro";
import EquipmentFilm from "./EquipmentFilm.astro";
import ProcurementCtaTier from "./ProcurementCtaTier.astro";
const {locale="en"}=Astro.props;
const s=baseline.product.specifications,c=baseline.product.standardConfiguration,p=baseline.product.manufacturerReportedPerformance;
const rows=[
 ["Applicable light pole height",`${s.applicablePoleHeightM} m pole class`],["Rated load",`${s.ratedLoadKg} kg`],["Power supply",`${s.batteryVoltageV} V rechargeable battery`],["Hydraulic module",`${s.hydraulicModuleDimensionsMm.join(" × ")} mm · ${s.hydraulicModuleWeightKg} kg`],["Electrical cabinet",`${s.electricalCabinetDimensionsMm.join(" × ")} mm · ${s.electricalCabinetWeightKg} kg`],["Total equipment weight",`${s.totalWeightKg} kg`],["Packaging dimensions",`${s.packagingDimensionsMm.join(" × ")} mm`],["Operators listed in the sheet",s.operators],["Anchor bolt sizes listed",s.listedAnchorBoltSizes.join(" / ")],["Flange hole span shown",`${s.flangeHoleSpanMm.join("–")} mm`]
];
---
<main id="main">
  <div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / The equipment</p><section class="hero-grid"><div class="hero-copy"><p class="eyebrow">Product / Specification reference</p><h1>Portable light<br/>pole lifter.</h1><p class="lead muted">The volvet light pole jack is a battery-powered hydraulic system for road-lighting installation. Review the two-module configuration and confirm the connection to your pole and foundation.</p><div class="actions"><a class="button" href="/quote/">Discuss your configuration <span aria-hidden="true">↗</span></a><a class="text-link" href="#specifications">View specifications ↓</a></div></div><ProductGallery/></section><SpecStrip/></div>
  <section class="section" id="specifications" data-source-id="S4" data-baseline-version={baseline.version}><div class="wrap two-column"><div><p class="eyebrow">01 / Specification sheet</p><h2>The numbers.<br/>And their context.</h2><p class="muted" style="margin-top:22px">These are the values listed in the product specification sheet supplied for this equipment. They define the information to review, rather than a universal approval for every pole or site.</p><a class="text-link" style="margin-top:24px" href="/guides/pole-jack-compatibility/">Review compatibility <span aria-hidden="true">→</span></a><p class="note"><span>The flange diagram includes dimension terminology that still requires engineering clarification. Final connection details must be reviewed for the actual project.</span> <span>Non-standard bases require a dimensioned drawing review.</span></p></div><div class="table-scroll"><table class="technical-table"><tbody>{rows.map(([label,value])=><tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody></table></div></div></section>
  <section class="section dark-section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">02 / Structure</p><h2>Separate modules.<br/>Defined responsibilities.</h2></div><p class="muted">The sheet identifies a hydraulic lifting assembly, an electrical cabinet and an equipment connecting plate. Confirm how the supplied set connects to your pole-base arrangement.</p></div><div class="product-film"><EquipmentFilm locale={locale} id="product-equipment-film"/></div><div class="feature-columns"><div class="feature-column"><span>HYDRAULIC MODULE</span><h3>Lifting components</h3><p>Hydraulic cylinder, hydraulic valve, oil pump and oil pressure gauge.</p></div><div class="feature-column"><span>ELECTRICAL CABINET</span><h3>Power and controls</h3><p>Control system, hydraulic pump, {s.batteryVoltageV} V battery, current and voltage meters, and lift buttons.</p></div><div class="feature-column"><span>CONNECTION</span><h3>Project-specific fit</h3><p>Review the flange drawing, anchor bolt sizes, foundation details and assembled pole load before confirming suitability.</p></div></div></div></section>
  <section class="section"><div class="wrap two-column"><div><p class="eyebrow">03 / Standard configuration</p><h2>Know what<br/>the set includes.</h2><p class="muted" style="margin-top:22px">Listed compatibility and included parts are separate pieces of information. In particular, M24 appears in the compatibility table but not in the standard included bolt list.</p></div><table class="technical-table"><tbody><tr><th>Equipment</th><td>{c.equipmentSets} set</td></tr><tr><th>Anchor bolt sets</th><td>{c.anchorBoltSizesIncluded.map(x=><div>{x} · {c.anchorBoltSetsPerSize} sets</div>)}</td></tr><tr><th>Ground stakes</th><td>{c.groundStakeSets} set</td></tr></tbody></table></div></section>
  <div class="wrap"><PackagingShowcase/></div>
  <section class="section" style="padding-top:0"><div class="wrap evidence-panel" data-evidence-status="specification-only"><div class="two-column"><div><p class="eyebrow">04 / Performance evidence</p><h3><span>Manufacturer-reported.</span><br/><span>Field validation pending.</span></h3><p style="margin-top:18px">The sheet lists the figures alongside. The actual test load, site conditions, timing method and repeatability are still being documented. Lifting time is not a statement of total installation time, and usage count is not a guaranteed service life.</p></div><table class="technical-table"><tbody><tr><th>Reported lift time</th><td>{p.liftTimeSeconds} s</td></tr><tr><th>Lifts per full charge</th><td>{p.liftsPerFullCharge}</td></tr><tr><th>Reported usage cycles</th><td>{p.usageCycles}</td></tr></tbody></table></div></div></section>
  <section class="section" id="product-faq" style="padding-top:0"><div class="wrap two-column"><div><p class="eyebrow">05 / Product questions</p><h2>Common questions.<br/>Clear boundaries.</h2><p class="muted" style="margin-top:22px">Answers grounded in the current specification sheet. Non-standard bases require a dimensioned drawing review.</p></div><div>{productFaq.map(([question,answer],i)=><details class="faq-item" open={i===0}><summary><span class="kicker">{String(i+1).padStart(2,"0")}</span>{question}<span aria-hidden="true">＋</span></summary><p>{answer}</p></details>)}</div></div></section>
  <section class="section" style="padding-top:0"><div class="wrap"><ProcurementCtaTier locale={locale} highlightTier={1}/></div></section>
</main>
<style>.product-film{margin-bottom:48px;--muted:#c0c9ba;--line:#ffffff30}</style>
