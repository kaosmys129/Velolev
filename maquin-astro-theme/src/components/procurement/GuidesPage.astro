---
import {corePages,localizePath} from "../../lib/site-config.mjs";import {loadPublishedSnapshot} from "../../lib/reviewed-snapshot.mjs";import localizedContent from "../../data/published-content-locales.json";
const {locale="en"}=Astro.props;
const groups=[{name:"01 / Equipment & fit",keys:["product","compatibility","resources"]},{name:"02 / Methods & economics",keys:["method","compare","roi"]},{name:"03 / Application planning",keys:["solar","parking","faq"]}];
const snapshot=loadPublishedSnapshot();
const visibleArticles=snapshot.articles;
---
<main id="main"><div class="wrap"><p class="breadcrumb"><a href={locale==="en"?"/":`/${locale}/`}>velolev</a> / Guides & tools</p><header class="page-intro"><p class="eyebrow">From a question to a project brief</p><h1>Choose the next<br/>decision to resolve.</h1><p class="lead muted">Read the equipment facts, prepare a compatibility review and compare a defined work scope. Planning content is kept separate from field instructions and test evidence.</p></header>{groups.map(group=><section class="guide-group"><h2 class="eyebrow">{group.name}</h2><div class="guide-grid">{group.keys.map(key=><a class="guide-card" href={localizePath(corePages[key].path,locale)}><h3>{corePages[key].title.split(" | ")[0]}</h3><p>{corePages[key].description}</p><span class="text-link">Open the guide ↗</span></a>)}</div></section>)}{visibleArticles.length>0&&<section class="guide-group"><h2 class="eyebrow">Reviewed articles</h2><div class="guide-grid">{visibleArticles.map(a=>{const loc=locale!=="en"?localizedContent[locale]?.[a.slug]:null;const hasLocalePage=locale==="en"||Boolean(loc);return <a class="guide-card" href={hasLocalePage?localizePath(`/guides/${a.slug}/`,locale):`/guides/${a.slug}/`}><h3>{loc?.title||a.title}</h3><p>{loc?.description||a.description}</p><span class="text-link">{hasLocalePage?"Read the article ↗":"Read in English ↗"}</span></a>;})}</div></section>}<section class="evidence-panel"><h2>Have the drawing?<br/>Start the review.</h2><p>Share your destination, assembly and foundation information. Unknown details can be followed up; the form does not automatically approve a configuration.</p><div class="actions"><a class="button" href={localizePath("/quote/",locale)}>Send project information ↗</a><a class="text-link" href={localizePath("/editorial-policy/",locale)}>How product information is checked</a></div></section></div></main>
