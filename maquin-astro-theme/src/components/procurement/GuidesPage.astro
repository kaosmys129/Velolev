---
import {corePages} from "../../lib/site-config.mjs";import {loadPublishedSnapshot} from "../../lib/reviewed-snapshot.mjs";
const groups=[{name:"01 / Equipment & fit",keys:["product","compatibility","resources"]},{name:"02 / Methods & economics",keys:["method","compare","roi"]},{name:"03 / Application planning",keys:["solar","parking","faq"]}];const snapshot=loadPublishedSnapshot();
---
<main id="main"><div class="wrap"><p class="breadcrumb"><a href="/">volvet</a> / Guides & tools</p><header class="page-intro"><p class="eyebrow">From a question to a project brief</p><h1>Choose the next<br/>decision to resolve.</h1><p class="lead muted">Read the equipment facts, prepare a compatibility review and compare a defined work scope. Planning content is kept separate from field instructions and test evidence.</p></header>{groups.map(group=><section class="guide-group"><h2 class="eyebrow">{group.name}</h2><div class="guide-grid">{group.keys.map(key=><a class="guide-card" href={corePages[key].path}><h3>{corePages[key].title.split(" | ")[0]}</h3><p>{corePages[key].description}</p><span class="text-link">Open the guide ↗</span></a>)}</div></section>)}{snapshot.articles.length>0&&<section class="guide-group"><h2 class="eyebrow">Reviewed articles</h2><div class="guide-grid">{snapshot.articles.map(a=><a class="guide-card" href={`/guides/${a.slug}/`}><h3>{a.title}</h3><p>{a.description}</p><span class="text-link">Read the article ↗</span></a>)}</div></section>}<section class="evidence-panel"><h2>Have the drawing?<br/>Start the review.</h2><p>Share your destination, assembly and foundation information. Unknown details can be followed up; the form does not automatically approve a configuration.</p><div class="actions"><a class="button" href="/quote/">Send project information ↗</a><a class="text-link" href="/editorial-policy/">How product information is checked</a></div></section></div></main>
