---
import baseline from '../../data/content-baseline.json';
import {translateText} from '../../lib/industrial-localization.mjs';
import {localizedPagePath} from '../../lib/site-config.mjs';
import {flangeMessages,checkFlange} from '../../lib/flange-checker.mjs';
const {locale='en',id='flange-instant-checker'}=Astro.props;
const t=value=>translateText(value,locale);
const messages=Object.fromEntries(flangeMessages.map(key=>[key,t(key)]));
const initial=checkFlange({span:220,bolt:'M20',holes:'4'});
const bolts=[...baseline.product.specifications.listedAnchorBoltSizes,'M27','M30','Other'];
---
<section class="flange-checker" id={id} data-flange-checker data-copy={JSON.stringify(messages)} data-quote-path={localizedPagePath('quote',locale)}>
  <div class="section-head">
    <div><p class="eyebrow">Connection / Quick check</p><h2>Check your<br/>base dimensions.</h2></div>
    <p class="muted">Compare your flange hole span and bolt size with the listed equipment range. Keep the dimensioned drawing ready for a complete connection review.</p>
  </div>
  <div class="checker-grid">
    <div class="checker-controls">
      <div class="checker-presets" role="group" aria-label="Example base dimensions">
        {[['200','M18'],['220','M20'],['240','M24'],['300','M30']].map(([span,bolt])=><button type="button" class="checker-preset" aria-pressed={span==='220'?'true':'false'} data-span={span} data-bolt={bolt}>{span} mm / {bolt}</button>)}
      </div>
      <div class="checker-input-row"><label for={`${id}-span`}>Flange hole span</label><div><input id={`${id}-span`} data-span-input type="number" min="100" max="400" step="any" value="220" aria-describedby={`${id}-help`}/><span>mm</span></div></div>
      <input class="checker-range" data-span-slider type="range" min="100" max="400" step="1" value="220" aria-label="Flange hole span"/>
      <p class="note" id={`${id}-help`}>Listed span: 180–260 mm. Confirm how your drawing defines the measurement.</p>
      <fieldset class="checker-bolts"><legend>Anchor bolt size</legend><div>{bolts.map(size=><label><input type="radio" name={`${id}-bolt`} value={size} checked={size==='M20'}/><span>{size==='Other'?'Other bolt size':size}</span></label>)}</div></fieldset>
      <label class="checker-pattern">Hole pattern<select data-hole-pattern><option value="4">4 holes</option><option value="6">6 holes</option><option value="8">8 holes</option></select></label>
    </div>
    <div class="checker-result" data-status={initial.status}>
      <div class="checker-drawing" aria-hidden="true">
        <svg viewBox="0 0 360 180" fill="none"><path d="M0 90h360M180 0v180" stroke="currentColor" stroke-dasharray="4 5" opacity=".3"/><circle cx="180" cy="90" r="62" stroke="currentColor" stroke-dasharray="3 5"/><path d="M120 30h120v120H120z" stroke="currentColor"/><g fill="var(--paper)" stroke="currentColor"><circle cx="136" cy="46" r="7"/><circle cx="224" cy="46" r="7"/><circle cx="136" cy="134" r="7"/><circle cx="224" cy="134" r="7"/></g><path d="m136 46 88 88M130 40l12 12m76 76 12 12" stroke="currentColor"/></svg>
        <span class="kicker">180–260 mm / M16–M24</span>
      </div>
      <div class="checker-verdict" aria-live="polite" aria-atomic="true">
        <p class="eyebrow">Specification comparison</p><h3 data-verdict>{t(initial.title)}</h3><p class="muted" data-explanation>{t(initial.description)}</p>
        <dl><div><dt>Flange hole span</dt><dd data-span-result>220 mm</dd></div><div><dt>Anchor bolt size</dt><dd data-bolt-result>M20</dd></div><div><dt>Hardware</dt><dd data-hardware>{t(initial.hardware)}</dd></div></dl>
      </div>
      <a class="button" data-flange-inquiry href={`${localizedPagePath('quote',locale)}?context=flange&span=220&bolt=M20&holes=4`}>Request a connection review <span aria-hidden="true">↗</span></a>
      <p class="note">A dimension check supports project preparation. The assembled load, foundation and site also need review.</p>
    </div>
  </div>
</section>
<script>
import {checkFlange} from '../../lib/flange-checker.mjs';
for(const root of document.querySelectorAll<HTMLElement>('[data-flange-checker]')){
  const copy:Record<string,string>=JSON.parse(root.dataset.copy??'{}'),t=(key:string)=>copy[key]??key;
  const input=root.querySelector<HTMLInputElement>('[data-span-input]')!,slider=root.querySelector<HTMLInputElement>('[data-span-slider]')!,pattern=root.querySelector<HTMLSelectElement>('[data-hole-pattern]')!;
  const presets=root.querySelectorAll<HTMLButtonElement>('.checker-preset');
  const update=()=>{
    const bolt=root.querySelector<HTMLInputElement>('input[type=radio]:checked')!.value;
    const result=checkFlange({span:input.value,bolt,holes:pattern.value});
    root.querySelector<HTMLElement>('.checker-result')!.dataset.status=result.status;
    root.querySelector('[data-verdict]')!.textContent=t(result.title);
    root.querySelector('[data-explanation]')!.textContent=t(result.description);
    root.querySelector('[data-span-result]')!.textContent=result.status==='invalid'?'—':t('{value} mm').replace('{value}',Number(input.value).toLocaleString(document.documentElement.lang));
    root.querySelector('[data-bolt-result]')!.textContent=bolt==='Other'?t('Base drawing required'):bolt;
    root.querySelector('[data-hardware]')!.textContent=t(result.hardware);
    input.setAttribute('aria-invalid',String(result.status==='invalid'));
    const query=result.status==='invalid'?new URLSearchParams({context:'flange'}):new URLSearchParams({context:'flange',span:input.value,bolt,holes:pattern.value});
    root.querySelector<HTMLAnchorElement>('[data-flange-inquiry]')!.href=`${root.dataset.quotePath}?${query}`;
    for(const preset of presets)preset.setAttribute('aria-pressed',String(preset.dataset.span===input.value&&preset.dataset.bolt===bolt&&pattern.value==='4'));
  };
  input.addEventListener('input',()=>{if(input.value!=='')slider.value=input.value;update();});
  slider.addEventListener('input',()=>{input.value=slider.value;update();});
  root.querySelectorAll('input[type=radio]').forEach(radio=>radio.addEventListener('change',update));
  pattern.addEventListener('change',update);
  for(const preset of presets)preset.addEventListener('click',()=>{
    input.value=preset.dataset.span!;slider.value=input.value;pattern.value='4';
    for(const radio of root.querySelectorAll<HTMLInputElement>('input[type=radio]'))radio.checked=radio.value===preset.dataset.bolt;
    update();
  });
}
</script>
<style>
.flange-checker{border-top:1px solid var(--line);padding-top:45px}.checker-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:70px}.checker-controls{min-width:0}.checker-presets{display:grid;grid-template-columns:1fr 1fr;margin-bottom:32px;border-top:1px solid var(--line);border-left:1px solid var(--line)}.checker-preset{min-height:48px;background:transparent;border:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:12px;font:12px 'Courier New',monospace;cursor:pointer;color:var(--ink)}.checker-preset:hover{background:var(--white)}.checker-preset[aria-pressed=true]{background:var(--yellow)}.checker-input-row{display:flex;justify-content:space-between;align-items:center;gap:20px;font-size:13px}.checker-input-row>div{display:flex;align-items:center;gap:12px}.checker-input-row input{width:100px;padding:12px;border:1px solid var(--line);background:var(--white);border-radius:2px;color:var(--ink);min-height:48px}.checker-range{width:100%;margin:26px 0 0;accent-color:var(--ink);min-height:24px}.checker-bolts{border:0;padding:28px 0;margin:28px 0 0;border-top:1px solid var(--line)}.checker-bolts legend{font-size:13px;padding-right:16px}.checker-bolts>div{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.checker-bolts label{position:relative;cursor:pointer;min-width:0}.checker-bolts input{position:absolute;opacity:0;width:100%;height:100%;margin:0}.checker-bolts span{display:flex;align-items:center;justify-content:center;min-height:48px;padding:10px 5px;border:1px solid var(--line);font-size:12px;text-align:center;overflow-wrap:anywhere}.checker-bolts input:checked+span{background:var(--yellow);border-color:var(--ink)}.checker-bolts input:focus-visible+span{outline:3px solid #947500;outline-offset:3px}.checker-pattern{display:grid;gap:12px;font-size:13px}.checker-pattern select{padding:13px;border:1px solid var(--line);background:var(--white);border-radius:2px;color:var(--ink);min-height:48px;width:100%}.checker-result{background:var(--white);padding:30px;min-width:0;border-top:3px solid var(--yellow)}.checker-drawing{background:var(--paper);padding:0 20px 14px;margin-bottom:28px;text-align:center;color:var(--muted)}.checker-drawing svg{width:100%;height:150px;display:block}.checker-drawing .kicker{font-size:11px}.checker-verdict .eyebrow{margin-bottom:16px}.checker-verdict h3{line-height:1.25}.checker-verdict p.muted{font-size:14px;margin-top:16px}.checker-verdict dl{font-size:13px;margin:24px 0}.checker-verdict dl>div{display:grid;grid-template-columns:1fr 1fr;gap:20px;border-top:1px solid var(--line);padding:14px 0}.checker-verdict dt{color:var(--muted)}.checker-verdict dd{margin:0;text-align:right;overflow-wrap:anywhere}.checker-result .button{width:100%;font-size:13px;gap:15px}.checker-result[data-status=invalid]{border-color:#a52a20}
@media(max-width:1050px){.checker-grid{gap:32px}.checker-result{padding:24px}}@media(max-width:760px){.checker-grid{grid-template-columns:1fr;gap:32px}.flange-checker{padding-top:32px}.checker-result{padding:24px}.checker-bolts>div{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:360px){.checker-bolts>div{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
