---
import {decisionContent} from "../../data/decision-content.mjs";
import {corePages} from "../../lib/site-config.mjs";
import MediaFigure from "./MediaFigure.astro";
const {kind}=Astro.props;const p=decisionContent[kind];
const visual={
  solar:{image:"/images/evidence/jobsite-rural-solar-street-light.jpg",alt:"Rural roadside reference illustration with a yellow wheeled lifting frame and pole",label:"01 / Rural access context",caption:"Application illustration · Review the complete solar assembly, foundation and site for your project.",detail:"/images/evidence/equipment-trolley-side-detail.jpg",detailAlt:"Reference view of the hydraulic pump, frame and wheels",detailLabel:"02 / Equipment detail",detailCaption:"Frame and hydraulic detail reference. Confirm the actual supplied equipment and handling arrangements."},
  parking:{image:"/images/evidence/jobsite-parking-lot-tight-space.jpg",alt:"Urban access reference illustration showing a lifting frame beside a pole and landscaped walkway",label:"01 / Urban access context",caption:"Application illustration · Confirm the actual parking layout, access and occupied work area.",detail:"/images/evidence/jobsite-sidewalk-municipal-road.jpg",detailAlt:"Urban sidewalk reference illustration showing a lifting frame beside a pole",detailLabel:"02 / Access reference",detailCaption:"Access context illustration. Share photographs and a plan of the actual work area for review."},
  method:{image:"/images/evidence/field-installation-flange-erect.jpg",alt:"Reference view of a stationary pole and yellow lifting frame",label:"01 / Connection reference",caption:"Equipment reference · The actual load, connection and work method require a project review."}
}[kind];
---
<main id="main"><div class="wrap"><p class="breadcrumb"><a href="/">volvet</a> / {p.eyebrow}</p><div class:list={["decision-hero",{"has-visual":Boolean(visual)}]}><header class="page-intro"><p class="eyebrow">{p.eyebrow}</p><h1 style="white-space:pre-line">{p.title}</h1><p class="lead muted">{p.intro}</p></header>{visual&&<div class="decision-cover"><MediaFigure src={visual.image} alt={visual.alt} label={visual.label} caption={visual.caption} eager/><div class="visual-index" aria-label="Project review inputs"><span>01 / Site</span><span>02 / Assembly</span><span>03 / Foundation</span></div></div>}</div><p class="scope-note" data-evidence-boundary>{p.boundary}</p><div class="policy-layout"><aside aria-label="On this page">{p.sections.map(s=><a href={`#${s.id}`}>{s.title}</a>)}<a href="/resources/">Project documents ↗</a></aside><article class="policy-body">{p.sections.map((s,index)=><><section id={s.id}><h2>{s.title}</h2><p>{s.body}</p>{s.items&&<ul>{s.items.map(item=><li>{item}</li>)}</ul>}</section>{index===0&&visual?.detail&&<div class="article-image-pair"><MediaFigure src={visual.detail} alt={visual.detailAlt} label={visual.detailLabel} caption={visual.detailCaption}/><MediaFigure src="/images/evidence/field-installation-flange-erect.jpg" alt="Reference image showing the lifting frame alongside the pole base" label="03 / Connection detail" caption="Connection reference · Include the flange, anchor bolts and foundation drawings in your project brief."/></div>}</>)}
{kind==="compare"&&<div class="comparison-matrix-wrapper">
  <div class="matrix-header">
    <span class="matrix-badge">FOUR-DIMENSIONAL BENCHMARK</span>
    <h3>Equipment Comparison: volvet Portable Lifter vs. Mobile Truck Crane</h3>
    <p class="muted">A structured engineering comparison across total machinery overhead, jobsite footprint, structural erection safety, and energy autonomy.</p>
  </div>

  <div class="table-responsive">
    <table class="decision-matrix-table">
      <thead>
        <tr>
          <th style="width: 24%;">Decision Dimension</th>
          <th style="width: 40%;" class="highlight-col">volvet Portable Lifter (85 kg Split)</th>
          <th style="width: 36%;">Mobile Truck Crane (Contracted Fleet)</th>
        </tr>
      </thead>
      <tbody>
        {p.matrix ? p.matrix.map((row) => (
          <tr>
            <th scope="row">
              <span class="dim-cat">{row.category}</span>
              <strong>{row.dimension}</strong>
            </th>
            <td class="highlight-col">
              <p class="td-desc">{row.lifter}</p>
              <div class="matrix-benefit-tag">
                <span class="benefit-icon">✓</span>
                <span>{row.advantage}</span>
              </div>
            </td>
            <td>
              <p class="td-desc muted">{row.crane}</p>
            </td>
          </tr>
        )) : null}
      </tbody>
    </table>
  </div>

  <div class="matrix-cards-mobile">
    {p.matrix && p.matrix.map((row, idx) => (
      <article class="matrix-card">
        <div class="card-head">
          <span class="step-num">0{idx + 1}</span>
          <span class="card-category">{row.category}</span>
        </div>
        <h4 class="card-title">{row.dimension}</h4>
        <div class="compare-block lifter-block">
          <span class="block-label">volvet Portable Lifter:</span>
          <p>{row.lifter}</p>
          <div class="matrix-benefit-tag">
            <span class="benefit-icon">✓</span>
            <span>{row.advantage}</span>
          </div>
        </div>
        <div class="compare-block crane-block">
          <span class="block-label muted">Mobile Truck Crane:</span>
          <p class="muted">{row.crane}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="matrix-boundary-box">
    <span class="matrix-boundary-tag">ENGINEERING APPLICABILITY BOUNDARY</span>
    <p>For heavy poles exceeding 12m or structural components over 300kg (such as high-mast stadium lighting or high-voltage transmission pylons), heavy mobile cranes remain indispensable. For standard 6m–12m municipal lighting, parking installations, and off-grid solar roadways, the volvet portable lifter delivers proven cost efficiency and site access advantages.</p>
  </div>
</div>}
{p.reference&&<p class="note">General planning reference: <a class="text-link" href="https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm" target="_blank" rel="noopener noreferrer">UK HSE: planning and organising lifting operations ↗</a>. This is UK guidance on competent planning; it does not certify this equipment or determine the rules for another destination.</p>}
<div class="related-links"><p class="eyebrow">Continue your review</p>{p.related.map(key=><a href={corePages[key].path}>{corePages[key].title.split(" | ")[0]} <span>↗</span></a>)}</div><div class="evidence-panel"><h3>Bring the information you have.</h3><p>Unknown details can be flagged for follow-up. A request starts the configuration review; it does not approve the equipment for use.</p><a class="button" href={`/quote/${p.application?`?application=${p.application}`:""}`}>Send project information ↗</a></div></article></div></div></main>
<style>
  .decision-hero.has-visual{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:center;margin:20px 0 46px}.has-visual .page-intro{padding:28px 0}.has-visual h1{font-size:clamp(36px,4.3vw,60px)}.decision-cover{min-width:0}.visual-index{display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line);padding-top:18px;margin-top:20px;font:10px/1.5 'Courier New',monospace;text-transform:uppercase;letter-spacing:.03em;color:var(--muted)}
  .article-image-pair{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:8px 0 38px}.article-image-pair :global(a){text-decoration:none}

  /* 四维对比矩阵样式 */
  .comparison-matrix-wrapper {
    margin: 40px 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 32px 28px;
  }
  .matrix-header {
    margin-bottom: 24px;
  }
  .matrix-badge {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: var(--ink);
    color: var(--white);
    padding: 3px 6px;
    border-radius: 2px;
    display: inline-block;
    margin-bottom: 8px;
  }
  .matrix-header h3 {
    font-size: 22px;
    font-weight: 650;
    margin: 0 0 6px 0;
    color: var(--ink);
  }
  .matrix-header p {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }
  .table-responsive {
    overflow-x: auto;
    margin-bottom: 24px;
  }
  .decision-matrix-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
    border: 1px solid var(--line);
  }
  .decision-matrix-table th,
  .decision-matrix-table td {
    padding: 18px 16px;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .decision-matrix-table thead th {
    background: #edf1e8;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
  }
  .decision-matrix-table thead th.highlight-col {
    background: #fffdf0;
    color: #8c6b00;
    border-bottom: 2px solid var(--yellow);
  }
  .decision-matrix-table tbody th {
    background: #fafbf9;
  }
  .dim-cat {
    display: block;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: var(--muted);
    font-weight: 600;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .decision-matrix-table tbody td.highlight-col {
    background: #fffdf5;
    border-left: 2px solid var(--yellow);
    border-right: 2px solid var(--yellow);
  }
  .td-desc {
    font-size: 13px;
    line-height: 1.55;
    margin: 0 0 10px 0;
  }
  .matrix-benefit-tag {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    background: #f1f6ec;
    border: 1px solid #c2dbb5;
    padding: 6px 10px;
    border-radius: 2px;
    font-size: 12px;
    font-weight: 600;
    color: #27521c;
    line-height: 1.4;
  }
  .benefit-icon {
    font-weight: 700;
    color: #2e691b;
  }

  .matrix-cards-mobile {
    display: none;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
  }
  .matrix-card {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 20px;
    border-radius: 2px;
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 6px;
  }
  .card-head .step-num {
    font-family: 'Courier New', monospace;
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
  }
  .card-category {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
  }
  .card-title {
    font-size: 16px;
    font-weight: 650;
    color: var(--ink);
    margin: 0 0 14px 0;
  }
  .compare-block {
    padding: 12px 14px;
    border-radius: 2px;
    margin-bottom: 10px;
  }
  .lifter-block {
    background: #fffdf5;
    border: 1px solid #eedb96;
    border-left: 3px solid var(--yellow);
  }
  .crane-block {
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .block-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 4px;
    color: var(--ink);
  }
  .compare-block p {
    font-size: 13px;
    line-height: 1.5;
    margin: 0 0 8px 0;
  }

  .matrix-boundary-box {
    background: #e6e9de;
    border-left: 3px solid var(--yellow);
    padding: 14px 18px;
    border-radius: 2px;
  }
  .matrix-boundary-tag {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--muted);
    display: block;
    margin-bottom: 4px;
  }
  .matrix-boundary-box p {
    font-size: 12px;
    line-height: 1.55;
    margin: 0;
    color: var(--ink);
  }

  @media(max-width:1050px){.decision-hero.has-visual{gap:30px;grid-template-columns:1.05fr .95fr}}
  @media(max-width:820px){
    .table-responsive { display: none; }
    .matrix-cards-mobile { display: flex; }
    .comparison-matrix-wrapper { padding: 20px 16px; }
  }
  @media(max-width:760px){.decision-hero.has-visual{grid-template-columns:1fr;gap:16px;margin-bottom:30px}.has-visual .page-intro{padding:12px 0 20px}.article-image-pair{grid-template-columns:1fr;gap:28px}.visual-index{font-size:9px}}
</style>
