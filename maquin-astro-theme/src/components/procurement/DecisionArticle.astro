---
import {decisionContent} from "../../data/decision-content.mjs";
import {corePages} from "../../lib/site-config.mjs";
import MediaFigure from "./MediaFigure.astro";
const {kind}=Astro.props;const p=decisionContent[kind];
const visual={
  solar:{image:"/images/evidence/jobsite-rural-solar-street-light.jpg",alt:"Rural roadside reference illustration with a yellow wheeled lifting frame and pole",label:"01 / Rural access context",caption:"Application illustration · Review the complete solar assembly, foundation and site for your project.",detail:"/images/evidence/equipment-trolley-side-detail.jpg",detailAlt:"Reference view of the hydraulic pump, frame and wheels",detailLabel:"02 / Equipment detail",detailCaption:"Frame and hydraulic detail reference. Confirm the actual supplied equipment and handling arrangements."},
  parking:{image:"/images/evidence/jobsite-parking-lot-tight-space.jpg",alt:"Urban access reference illustration showing a lifting frame beside a pole and landscaped walkway",label:"01 / Urban access context",caption:"Application illustration · Confirm the actual parking layout, access and occupied work area.",detail:"/images/evidence/jobsite-sidewalk-municipal-road.jpg",detailAlt:"Urban sidewalk reference illustration showing a lifting frame beside a pole",detailLabel:"02 / Access reference",detailCaption:"Access context illustration. Share photographs and a plan of the actual work area for review."},
  method:{image:"/images/evidence/field-installation-flange-erect.jpg",alt:"Reference view of a stationary pole and yellow lifting frame",label:"01 / Connection reference",caption:"Equipment reference · The actual load, connection and work method require a project review."}
}[kind];
---
<main id="main"><div class="wrap"><p class="breadcrumb"><a href="/">velolev</a> / {p.eyebrow}</p><div class:list={["decision-hero",{"has-visual":Boolean(visual)}]}><header class="page-intro"><p class="eyebrow">{p.eyebrow}</p><h1 style="white-space:pre-line">{p.title}</h1><p class="lead muted">{p.intro}</p></header>{visual&&<div class="decision-cover"><MediaFigure src={visual.image} alt={visual.alt} label={visual.label} caption={visual.caption} eager/><div class="visual-index" aria-label="Project review inputs"><span>01 / Site</span><span>02 / Assembly</span><span>03 / Foundation</span></div></div>}</div><p class="scope-note" data-evidence-boundary>{p.boundary}</p><div class="policy-layout"><aside aria-label="On this page">{p.sections.map(s=><a href={`#${s.id}`}>{s.title}</a>)}<a href="/resources/">Project documents ↗</a></aside><article class="policy-body">{p.sections.map((s,index)=><><section id={s.id}><h2>{s.title}</h2><p>{s.body}</p>{s.items&&<ul>{s.items.map(item=><li>{item}</li>)}</ul>}</section>{index===0&&visual?.detail&&<div class="article-image-pair"><MediaFigure src={visual.detail} alt={visual.detailAlt} label={visual.detailLabel} caption={visual.detailCaption}/><MediaFigure src="/images/evidence/field-installation-flange-erect.jpg" alt="Reference image showing the lifting frame alongside the pole base" label="03 / Connection detail" caption="Connection reference · Include the flange, anchor bolts and foundation drawings in your project brief."/></div>}</>)}
{kind==="compare"&&<section class="comparison-matrix-wrapper" aria-label="Equipment comparison">
  <div class="matrix-header"><p class="eyebrow">Equipment comparison</p><h2>Four ways to compare.</h2><p class="muted">Consider cost, access, workflow and power across the same project scope.</p></div>
  <div class="comparison-wrap" tabindex="0" role="region" aria-label="Equipment comparison"><table class="decision-table">
    <caption>Portable pole lifter / Mobile truck crane</caption><thead><tr><th scope="col">Decision dimension</th><th scope="col">Portable pole lifter</th><th scope="col">Mobile truck crane</th></tr></thead>
    <tbody>{p.matrix.map(row=><tr><th scope="row">{row.dimension}</th><td><p>{row.lifter}</p><p class="matrix-benefit">{row.advantage}</p></td><td>{row.crane}</td></tr>)}</tbody>
  </table></div><p class="note">Compare the complete assembly, base connection and work area before selecting a method. Use full project costs in the calculator.</p>
</section>}
{p.reference&&<p class="note">General planning reference: <a class="text-link" href="https://www.hse.gov.uk/work-equipment-machinery/planning-organising-lifting-operations.htm" target="_blank" rel="noopener noreferrer">UK HSE: planning and organising lifting operations ↗</a>. This is UK guidance on competent planning; it does not certify this equipment or determine the rules for another destination.</p>}
<div class="related-links"><p class="eyebrow">Continue your review</p>{p.related.map(key=><a href={corePages[key].path}>{corePages[key].title.split(" | ")[0]} <span>↗</span></a>)}</div><div class="evidence-panel"><h3>Bring the information you have.</h3><p>Unknown details can be flagged for follow-up. A request starts the configuration review; it does not approve the equipment for use.</p><a class="button" href={`/quote/${p.application?`?application=${p.application}`:""}`}>Send project information ↗</a></div></article></div></div></main>
<style>
  .decision-hero.has-visual{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:center;margin:20px 0 46px}.has-visual .page-intro{padding:28px 0}.has-visual h1{font-size:clamp(36px,4.3vw,60px)}.decision-cover{min-width:0}.visual-index{display:flex;justify-content:space-between;gap:10px;border-top:1px solid var(--line);padding-top:18px;margin-top:20px;font:10px/1.5 'Courier New',monospace;text-transform:uppercase;letter-spacing:.03em;color:var(--muted)}
  .article-image-pair{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:8px 0 38px}.article-image-pair :global(a){text-decoration:none}


  .comparison-matrix-wrapper{margin:45px 0;border-top:1px solid var(--line);padding-top:32px}.matrix-header h2{font-size:clamp(28px,3vw,38px);margin-bottom:20px}.matrix-header .eyebrow{margin-bottom:18px}.matrix-header>p.muted{font-size:14px}.comparison-wrap{margin:28px 0 0}.decision-table{width:100%;min-width:560px;table-layout:fixed}.decision-table th:first-child{width:23%}.decision-table th{font-weight:600}.decision-table tbody th{background:var(--paper);font-size:13px}.decision-table td{background:var(--white)}.decision-table td:nth-child(2){border-top-color:var(--yellow)}.decision-table caption{font:11px 'Courier New',monospace;color:var(--muted)}.matrix-benefit{border-top:1px solid var(--line);padding-top:12px;font-size:12px;font-weight:600}.comparison-matrix-wrapper .note{margin-top:20px}
  @media(max-width:1050px){.decision-hero.has-visual{gap:30px;grid-template-columns:1.05fr .95fr}}
  @media(max-width:760px){.decision-hero.has-visual{grid-template-columns:1fr;gap:16px;margin-bottom:30px}.has-visual .page-intro{padding:12px 0 20px}.article-image-pair{grid-template-columns:1fr;gap:28px}.visual-index{font-size:9px}.decision-table{font-size:12px}.decision-table th,.decision-table td{padding:14px 12px}}
</style>
