---
import {procurementFaq} from "../../data/decision-content.mjs";import {corePages} from "../../lib/site-config.mjs";
---
<main id="main"><div class="wrap"><p class="breadcrumb"><a href="/">volvet</a> / Procurement questions</p><header class="page-intro"><p class="eyebrow">Facts / Configuration / Next steps</p><h1>Before the quote.<br/>Before the lift.</h1><p class="lead muted">Answers grounded in the current specification sheet, with project-specific questions kept open for review.</p></header><div class="faq-layout"><div class="faq-answers">{procurementFaq.map(([question,answer,key],i)=><details class="faq-item" open={i===0}><summary><span class="kicker">{String(i+1).padStart(2,"0")}</span>{question}<span aria-hidden="true">＋</span></summary><p>{answer}</p><a class="text-link" href={corePages[key].path}>Read the related information ↗</a></details>)}</div><aside class="evidence-panel"><p class="eyebrow">Your project may differ</p><h2>Ask with a drawing.</h2><p>A pole assembly, flange and foundation drawing helps identify what still needs confirmation.</p><a class="button" href="/quote/">Ask a project question ↗</a><a class="text-link" href="/resources/">Get the information worksheet</a></aside></div></div></main>
