---
import {corePages,localizedPagePath} from "../../lib/site-config.mjs";
const {locale="en",page="home"}=Astro.props;
const words={
 en:{trigger:"Solutions & tools",groups:["Applications","Compare & plan","Resources & guides"],links:{solar:["Solar street lighting","Review the complete pole assembly."],parking:["Parking & campus lighting","Plan foundations, access and work areas."],compare:["Pole lifter vs crane","Compare methods over the same scope."],roi:["Project cost calculator","Model costs with your own inputs."],resources:["Resource centre","Specifications and project documents."],guides:["Planning guides","Browse the next decision to resolve."],faq:["Frequently asked questions","Answers before requesting a quote."]}},
 es:{trigger:"Soluciones y herramientas",groups:["Aplicaciones","Comparar y planificar","Recursos y guías"],links:{solar:["Alumbrado público solar","Revise el conjunto completo del poste."],parking:["Aparcamientos y campus","Planifique bases, accesos y zonas de trabajo."],compare:["Elevador de postes o grúa","Compare métodos con el mismo alcance."],roi:["Calculadora de costos","Utilice los datos de su proyecto."],resources:["Centro de recursos","Especificaciones y documentos del proyecto."],guides:["Guías de planificación","Consulte las decisiones del proyecto."],faq:["Preguntas frecuentes","Respuestas antes de solicitar cotización."]}},
 fr:{trigger:"Solutions et outils",groups:["Applications","Comparer et planifier","Ressources et guides"],links:{solar:["Éclairage public solaire","Examinez l’ensemble complet du mât."],parking:["Parkings et campus","Préparez fondations, accès et zone de travail."],compare:["Lève-mât ou grue","Comparez les méthodes à périmètre égal."],roi:["Calculateur de coûts","Utilisez les données de votre projet."],resources:["Centre de ressources","Spécifications et documents du projet."],guides:["Guides de planification","Explorez les décisions à prendre."],faq:["Questions fréquentes","Des réponses avant de demander un devis."]}},
 pt:{trigger:"Soluções e ferramentas",groups:["Aplicações","Comparar e planejar","Recursos e guias"],links:{solar:["Iluminação pública solar","Analise o conjunto completo do poste."],parking:["Estacionamentos e campus","Planeje fundações, acesso e área de trabalho."],compare:["Elevador de postes ou guindaste","Compare métodos com o mesmo escopo."],roi:["Calculadora de custos","Use os dados do seu projeto."],resources:["Centro de recursos","Especificações e documentos do projeto."],guides:["Guias de planejamento","Explore as decisões do projeto."],faq:["Perguntas frequentes","Respostas antes de solicitar cotação."]}},
 vi:{trigger:"Giải pháp và công cụ",groups:["Ứng dụng","So sánh và lập kế hoạch","Tài liệu và hướng dẫn"],links:{solar:["Chiếu sáng đường phố năng lượng mặt trời","Xem xét toàn bộ tổ hợp cột."],parking:["Bãi đỗ xe và khuôn viên","Chuẩn bị móng, lối vào và khu vực làm việc."],compare:["Thiết bị dựng cột và xe cẩu","So sánh phương án cùng phạm vi công việc."],roi:["Công cụ tính chi phí","Sử dụng dữ liệu dự án của bạn."],resources:["Trung tâm tài liệu","Thông số và hồ sơ dự án."],guides:["Hướng dẫn lập kế hoạch","Xem các quyết định cần làm rõ."],faq:["Câu hỏi thường gặp","Thông tin trước khi yêu cầu báo giá."]}},
 th:{trigger:"โซลูชันและเครื่องมือ",groups:["การใช้งาน","เปรียบเทียบและวางแผน","เอกสารและคู่มือ"],links:{solar:["ไฟถนนพลังงานแสงอาทิตย์","พิจารณาชุดประกอบเสาทั้งหมด"],parking:["ลานจอดรถและพื้นที่โครงการ","เตรียมข้อมูลฐานราก ทางเข้า และพื้นที่ทำงาน"],compare:["เครื่องยกเสากับรถเครน","เปรียบเทียบวิธีในขอบเขตงานเดียวกัน"],roi:["เครื่องมือคำนวณต้นทุน","ใช้ข้อมูลโครงการของคุณเอง"],resources:["ศูนย์เอกสาร","ข้อมูลสเปกและเอกสารโครงการ"],guides:["แนวทางวางแผน","ดูประเด็นที่ต้องพิจารณาต่อ"],faq:["คำถามที่พบบ่อย","ข้อมูลก่อนขอใบเสนอราคา"]}},
 id:{trigger:"Solusi & alat",groups:["Aplikasi","Bandingkan & rencanakan","Dokumen & panduan"],links:{solar:["Penerangan jalan tenaga surya","Tinjau rakitan tiang secara lengkap."],parking:["Area parkir & kampus","Siapkan fondasi, akses, dan area kerja."],compare:["Pengangkat tiang atau crane","Bandingkan metode dengan lingkup setara."],roi:["Kalkulator biaya proyek","Gunakan data proyek Anda sendiri."],resources:["Pusat dokumen","Spesifikasi dan dokumen proyek."],guides:["Panduan perencanaan","Telusuri keputusan yang perlu ditinjau."],faq:["Pertanyaan umum","Jawaban sebelum meminta penawaran."]}}
};
const current=Object.hasOwn(words,locale)?locale:"en",copy=words[current];
const sections=[["solar","parking"],["compare","roi"],["resources","guides","faq"]];
const active=sections.flat().includes(page);
const target=key=>localizedPagePath(key,current)??corePages[key].path;
---
<details class:list={["nav-discovery",{"is-current":active}]} data-header-discovery>
 <summary id="header-discovery-trigger"><span>{copy.trigger}</span><svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="m1 1 5 5 5-5" stroke="currentColor" stroke-width="1.5"/></svg></summary>
 <div class="nav-discovery-panel" aria-labelledby="header-discovery-trigger">
  {sections.map((keys,index)=><section class:list={["discovery-group",{"discovery-resources":index===2}]} aria-labelledby={`discovery-group-${index}`}><h2 id={`discovery-group-${index}`}>{copy.groups[index]}</h2><ul>{keys.map(key=><li><a class="discovery-link" href={target(key)} aria-current={page===key?"page":undefined}><span class="discovery-link-copy"><span class="discovery-link-title">{copy.links[key][0]}{current!=="en"&&!localizedPagePath(key,current)&&<span class="discovery-language" lang="en">EN</span>}</span><span class="discovery-link-description">{copy.links[key][1]}</span></span><span class="discovery-arrow" aria-hidden="true">↗</span></a></li>)}</ul></section>)}
 </div>
</details>
<style>
 .nav-discovery{position:relative;flex-shrink:0}.nav-discovery>summary{display:flex;align-items:center;gap:9px;list-style:none;cursor:pointer;padding:10px 0;min-height:44px;border-bottom:1px solid transparent;font:inherit;white-space:nowrap}.nav-discovery>summary::-webkit-details-marker{display:none}.nav-discovery>summary::marker{content:""}.nav-discovery>summary svg{transition:transform .16s}.nav-discovery[open]>summary svg{transform:rotate(180deg)}.nav-discovery.is-current>summary,.nav-discovery[open]>summary{border-bottom-color:var(--ink)}.nav-discovery-panel{position:absolute;right:-26px;top:calc(100% + 16px);width:min(670px,calc(100vw - 64px));background:var(--paper);border:1px solid var(--line);border-top:3px solid var(--yellow);box-shadow:0 18px 45px #20262222;z-index:40;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);padding:24px;gap:22px 20px}.discovery-group{min-width:0}.discovery-group h2{font-size:10px;font-weight:650;letter-spacing:.13em;line-height:1.5;text-transform:uppercase;color:var(--muted);margin:0 12px 10px}.discovery-group ul{list-style:none;padding:0;margin:0}.discovery-group li+li{margin-top:3px}.discovery-link{display:flex;justify-content:space-between;align-items:start;gap:12px;padding:12px;border:1px solid transparent;min-width:0;border-radius:2px;transition:background .15s}.discovery-link-copy{min-width:0}.discovery-link-title{display:block;font-size:13px;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.discovery-link-description{display:block;margin-top:4px;color:var(--muted);font-size:11px;line-height:1.6;overflow-wrap:anywhere}.discovery-arrow{color:var(--muted);font-size:14px}.discovery-link:hover{background:#e5e9dc}.discovery-link[aria-current=page]{background:#e5e9dc;border-left:3px solid var(--yellow);padding-left:10px}.discovery-language{display:inline-block;vertical-align:middle;margin-left:6px;padding:1px 4px;border:1px solid #b9c2ad;color:#5e6a55;font-size:8px;line-height:1.4;letter-spacing:.04em;font-weight:500}.discovery-resources{grid-column:1/-1;border-top:1px solid var(--line);padding-top:18px}.discovery-resources ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.discovery-resources li+li{margin:0}
 @media(max-width:1280px){.nav-discovery{width:100%}.nav-discovery>summary{justify-content:space-between;padding:13px 0;white-space:normal}.nav-discovery-panel{position:static;width:100%;margin:8px 0 15px;padding:18px;box-shadow:none;gap:18px;background:#eceee4}}
 @media(max-width:600px){.nav-discovery-panel{grid-template-columns:minmax(0,1fr);padding:16px 10px}.discovery-resources{grid-column:auto}.discovery-resources ul{grid-template-columns:minmax(0,1fr)}.discovery-group h2{margin-bottom:6px}.discovery-link{padding:12px}.discovery-link-title{font-size:14px}.discovery-link-description{font-size:12px}}
 @media(prefers-reduced-motion:reduce){.nav-discovery>summary svg,.discovery-link{transition:none}}
</style>
<script>
 for(const disclosure of document.querySelectorAll<HTMLDetailsElement>("[data-header-discovery]")){
  const trigger=disclosure.querySelector<HTMLElement>("summary")!,links=disclosure.querySelectorAll<HTMLAnchorElement>(".discovery-link");
  disclosure.addEventListener("keydown",event=>{if(event.key==="Escape"&&disclosure.open){event.preventDefault();event.stopPropagation();disclosure.open=false;trigger.focus();}else if(event.target===trigger&&["ArrowDown","ArrowUp"].includes(event.key)){event.preventDefault();disclosure.open=true;(event.key==="ArrowDown"?links[0]:links[links.length-1])?.focus();}});
  document.addEventListener("pointerdown",event=>{if(disclosure.open&&!disclosure.contains(event.target as Node))disclosure.open=false;});
  disclosure.addEventListener("focusout",event=>{const next=event.relatedTarget;if(next instanceof Node){if(!disclosure.contains(next))disclosure.open=false;}else requestAnimationFrame(()=>{if(!disclosure.contains(document.activeElement))disclosure.open=false;});});
 }
</script>
