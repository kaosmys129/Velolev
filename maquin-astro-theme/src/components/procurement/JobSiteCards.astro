---
/**
 * JobSiteCards.astro
 * 施工工况实战画廊卡片网格组件
 * 展示市政人行道、密集停车场、偏远太阳能路灯等核心作业场景的真实实录
 */
interface Props {
  limit?: number;
  class?: string;
}

const { limit = 3, class: className = "" } = Astro.props;

const scenes = [
  {
    id: "sidewalk",
    title: "Narrow Sidewalks & Roadways",
    subtitle: "Municipal Lighting Maintenance",
    image: "/images/evidence/jobsite-sidewalk-municipal-road.jpg",
    tag: "Tight Urban Space",
    desc: "Ultra-compact 220 mm profile easily navigates pedestrian walkways and bike paths without heavy equipment access permits or surface weight restrictions.",
    benefit: "Protects finished pavement slabs from damage"
  },
  {
    id: "parking",
    title: "Dense Commercial Parking Lots",
    subtitle: "Campus & Retail Light Poles",
    image: "/images/evidence/jobsite-parking-lot-tight-space.jpg",
    tag: "Confined Access",
    desc: "Operates within standard marked parking stalls and landscaped medians, allowing 2 workers to safely erect replacement poles without blocking traffic lanes.",
    benefit: "2-man compact maneuverability between parking bays & obstacles"
  },
  {
    id: "rural",
    title: "Off-Grid Solar Light Deployments",
    subtitle: "Rural & Remote Roadways",
    image: "/images/evidence/jobsite-rural-solar-street-light.jpg",
    tag: "Off-Grid & Remote",
    desc: "Self-contained 24 V battery power package allows rapid pole raising on unpaved mountain roads and remote off-grid highways without field generators.",
    benefit: "Autonomous 24 V battery power for remote off-grid installation"
  }
];

const items = scenes.slice(0, limit);
---

<div class:list={["jobsite-showcase", className]}>
  <div class="jobsite-grid">
    {items.map((item) => (
      <article class="jobsite-card" id={`scene-${item.id}`}>
        <a class="jobsite-image-wrap" href={item.image} data-media-image data-caption={item.title} aria-label={`Enlarge image: ${item.title}`}>
          <span class="jobsite-badge">{item.tag}</span>
          <img
            src={item.image}
            alt={item.title}
            loading="lazy"
            width="680"
            height="380"
          />
          <span class="jobsite-expand" aria-hidden="true">↗</span>
        </a>
        <div class="jobsite-content">
          <p class="jobsite-kicker">{item.subtitle}</p>
          <h3>{item.title}</h3>
          <p class="jobsite-desc">{item.desc}</p>
          <div class="jobsite-highlight">
            <span class="highlight-icon" aria-hidden="true">✓</span>
            <span>{item.benefit}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
.jobsite-showcase{margin-top:40px}.jobsite-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.jobsite-card{display:flex;flex-direction:column;min-width:0;border-bottom:1px solid var(--line)}.jobsite-image-wrap{display:block;position:relative;aspect-ratio:16/10;background:var(--green);overflow:hidden}.jobsite-image-wrap img{width:100%;height:100%;object-fit:cover;transition:transform .2s}.jobsite-image-wrap:hover img{transform:scale(1.03)}.jobsite-badge{position:absolute;left:0;top:0;z-index:1;padding:7px 12px;background:var(--paper);font:10px/1.5 'Courier New',monospace;color:var(--ink);max-width:90%}.jobsite-expand{position:absolute;right:0;bottom:0;display:grid;place-items:center;width:44px;height:44px;background:var(--yellow);color:var(--ink);font-size:22px}.jobsite-content{padding:26px 0;display:flex;flex-direction:column;flex:1}.jobsite-kicker{font:10px/1.5 'Courier New',monospace;color:var(--muted);margin-bottom:14px}.jobsite-content h3{font-size:23px;line-height:1.25;margin-bottom:18px}.jobsite-desc{font-size:14px;line-height:1.7;color:var(--muted);flex:1}.jobsite-highlight{display:flex;align-items:start;gap:12px;margin-top:24px;padding-top:18px;border-top:1px solid var(--line);font-size:12px;font-weight:600}.highlight-icon{font-size:13px;color:var(--ink)}
@media(max-width:1050px){.jobsite-grid{gap:24px}.jobsite-content h3{font-size:21px}}@media(max-width:760px){.jobsite-grid{grid-template-columns:1fr;gap:32px}.jobsite-content{padding:24px 0}.jobsite-image-wrap{aspect-ratio:16/9}}
</style>
