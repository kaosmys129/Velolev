---
import {aboutFor} from "../../lib/about-content.mjs";
const {locale="en"}=Astro.props;
const copy=aboutFor(locale),current=copy.locale;
const data=copy.quality;
const badges=data.steps.map(s=>s.badge),benchStandard=data.note,stagePrefix=data.stagePrefix;

// 出厂 4 道严苛质检工序实景图文资产与说明
const stepVisuals = [
  {
    image: "/images/evidence/equipment-trolley-side-detail.jpg",
    alt: "Ultrasonic weld flaw detection and alloy structural inspection",
    caption: "Weld & Material Inspection"
  },
  {
    image: "/images/product/portable-pole-lifter-hero-cutout.png",
    alt: "Hydraulic circuit pressure-drop and seal integrity testing",
    caption: "Hydraulic Seal Hold Test"
  },
  {
    image: "/images/evidence/field-installation-flange-erect.jpg",
    alt: "300 kg proof-load vertical lift test rig calibration",
    caption: "300 kg Proof-Load Calibration"
  },
  {
    image: "/images/evidence/factory-crating-export-package.jpg",
    alt: "Shockproof reinforced export composite wooden crate packing",
    caption: "Export Wooden Crate Packaging"
  }
];
---

<section class="quality-testing-section" id="quality-assurance">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2>{data.title}</h2>
      </div>
      <div class="head-right">
        <p class="muted">{data.lead}</p>
        <div class="scope-note">
          <span class="note-tag">{benchStandard.tag}</span>
          <p>{benchStandard.text}</p>
        </div>
      </div>
    </div>

    <div class="steps-grid">
      {data.steps.map((step, idx) => (
        <article class="quality-card">
          <div class="card-accent"></div>
          <div class="card-inner">
            <div class="step-header">
              <span class="step-num">{step.step}</span>
              <span class="step-tag">{stagePrefix} 0{idx + 1}</span>
            </div>
            <div class="card-media">
              <img src={stepVisuals[idx].image} alt={stepVisuals[idx].alt} loading="lazy" class="step-image" />
              <span class="media-caption">{stepVisuals[idx].caption}</span>
            </div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc muted">{step.desc}</p>
            <div class="step-badge">
              <span>{badges[idx]}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .quality-testing-section {
    padding: 90px 0;
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 50px;
  }

  .head-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .scope-note {
    background: #e6e9de;
    border-left: 3px solid var(--yellow);
    padding: 12px 16px;
    border-radius: 2px;
  }

  .scope-note p {
    font-size: 13px;
    line-height: 1.5;
    margin: 4px 0 0 0;
    color: var(--ink);
  }

  .note-tag {
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .quality-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    min-width: 0;
    max-width: 100%;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .quality-card:hover {
    border-color: var(--yellow);
    transform: translateY(-2px);
  }

  .card-accent {
    height: 3px;
    width: 100%;
    background: var(--yellow);
  }

  .card-inner {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .step-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 10px;
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 135px;
    background: #f4f6f1;
    border: 1px solid var(--line);
    border-radius: 2px;
    margin-bottom: 14px;
    overflow: hidden;
  }

  .step-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.3s ease;
  }

  .quality-card:hover .step-image {
    transform: scale(1.04);
  }

  .media-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(29, 32, 30, 0.82);
    color: var(--white);
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    letter-spacing: 0.02em;
  }

  .step-num {
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 28px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
  }

  .step-tag {
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .step-title {
    font-size: 18px;
    font-weight: 650;
    line-height: 1.35;
    margin-bottom: 12px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .step-desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 20px 0;
    flex-grow: 1;
    overflow-wrap: anywhere;
  }

  .step-badge {
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .step-badge span {
    display: inline-block;
    background: #eef1ea;
    border: 1px solid var(--line);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink);
    padding: 4px 8px;
    border-radius: 2px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1050px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .steps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 760px) {
    .quality-testing-section {
      padding: 55px 0;
    }

    .steps-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
