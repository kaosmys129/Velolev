---
import {aboutFor} from "../../lib/about-content.mjs";
const {locale="en"}=Astro.props;
const copy=aboutFor(locale),current=copy.locale;
const data=copy.quality;
const benchStandard=data.note,stagePrefix=data.stagePrefix;

// 复用已验证的 4 张 S4 参考影像用于出货前项目核查四步说明
const stepImages=[
  "/images/evidence/equipment-trolley-side-detail.jpg",
  "/images/product/portable-pole-lifter-hero-cutout.png",
  "/images/evidence/field-installation-flange-erect.jpg",
  "/images/evidence/factory-crating-export-package.jpg"
];
---

<section class="quality-testing-section" id="quality-assurance">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2>{data.title}</h2>
      </div>
      <div class="head-right">
        <p class="muted">{data.lead}</p>
        <div class="scope-note">
          <span class="note-tag">{benchStandard.tag}</span>
          <p>{benchStandard.text}</p>
        </div>
      </div>
    </div>

    <!-- 4-Stage Pre-Project & Dispatch Confirmation Grid -->
    <div class="steps-grid">
      {data.steps.map((step, idx) => (
        <article class="quality-card">
          <div class="card-inner">
            <div class="step-header">
              <span class="step-num">{step.step}</span>
              <span class="step-tag">{stagePrefix} 0{idx + 1}</span>
            </div>
            <div class="card-media">
              <a class="step-media-link" href={stepImages[idx]} data-media-image data-caption={step.desc} aria-label={step.title}>
                <img src={stepImages[idx]} width="600" height="400" alt={step.title} loading="lazy" class="step-image" />
                <span class="step-expand" aria-hidden="true">↗</span>
              </a>
              <span class="media-caption">{step.badge}</span>
            </div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc muted">{step.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.quality-testing-section{padding:90px 0;background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.section-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;margin-bottom:50px}
.head-right{max-width:500px}
.scope-note{margin-top:24px;padding:16px 20px;font-size:12px;background:var(--white);border-left:3px solid var(--yellow);border-radius:2px}
.note-tag{display:block;font:700 11px 'Courier New',monospace;margin-bottom:8px;letter-spacing:.06em}
.steps-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--white)}
.quality-card{min-width:0;border-right:1px solid var(--line);padding:26px 20px;transition:background .2s}
.quality-card:last-child{border-right:0}
.quality-card:hover{background:#fafbf9}
.step-header{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:22px;font:11px 'Courier New',monospace;color:var(--muted)}
.step-tag{font-size:10px;letter-spacing:.05em;font-weight:600}
.step-num{font-size:18px;font-weight:700;color:var(--ink)}
.card-media{margin-bottom:20px}
.step-media-link{display:block;position:relative;background:var(--green);aspect-ratio:16/10;overflow:hidden;border:1px solid var(--line);border-radius:2px}
.step-image{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}
.step-media-link:hover .step-image{transform:scale(1.03)}
.step-expand{position:absolute;right:8px;bottom:8px;width:28px;height:28px;display:grid;place-items:center;background:var(--yellow);color:var(--ink);font-size:16px;z-index:2;border-radius:2px}
.media-caption{display:block;font:600 10px/1.5 'Courier New',monospace;color:var(--muted);padding-top:10px;letter-spacing:.04em}
.step-title{font-size:19px;line-height:1.3;margin-bottom:12px;overflow-wrap:anywhere;color:var(--ink);font-weight:650}
.step-desc{font-size:13px;line-height:1.65;margin:0}
@media(max-width:1050px){
.section-head{grid-template-columns:1fr;gap:20px}
.steps-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.quality-card{padding:26px 20px!important;border-bottom:1px solid var(--line)}
.quality-card:nth-child(2n){border-right:0}
.quality-card:nth-last-child(-n+2){border-bottom:0}
}
@media(max-width:760px){
.quality-testing-section{padding:55px 0}
}
@media(max-width:480px){
.steps-grid{grid-template-columns:1fr}
.quality-card{padding:24px 16px!important;border-right:0}
.quality-card:nth-last-child(2){border-bottom:1px solid var(--line)}
}
</style>
