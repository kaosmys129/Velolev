---
import {aboutFor} from "../../lib/about-content.mjs";
const {locale="en"}=Astro.props;
const copy=aboutFor(locale),current=copy.locale;
const data=copy.quality;
const benchStandard=data.note,stagePrefix=data.stagePrefix;

// Share the existing reference images and use native step copy for captions and alt text.
const stepImages=[
 "/images/evidence/equipment-trolley-side-detail.jpg",
 "/images/product/portable-pole-lifter-hero-cutout.png",
 "/images/evidence/field-installation-flange-erect.jpg",
 "/images/evidence/factory-crating-export-package.jpg"
];
---

<section class="quality-testing-section" id="quality-assurance">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2>{data.title}</h2>
      </div>
      <div class="head-right">
        <p class="muted">{data.lead}</p>
        <div class="scope-note">
          <span class="note-tag">{benchStandard.tag}</span>
          <p>{benchStandard.text}</p>
        </div>
      </div>
    </div>

    <div class="steps-grid">
      {data.steps.map((step, idx) => (
        <article class="quality-card">
          <div class="card-inner">
            <div class="step-header">
              <span class="step-num">{step.step}</span>
              <span class="step-tag">{stagePrefix} 0{idx + 1}</span>
            </div>
            <div class="card-media">
              <img src={stepImages[idx]} width="600" height="400" alt={step.title} loading="lazy" class="step-image" />
              <span class="media-caption">{step.badge}</span>
            </div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc muted">{step.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.quality-testing-section{padding:90px 0;background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.quality-testing-section .section-head{align-items:start}.head-right{max-width:500px}.head-right .scope-note{margin:24px 0 0;padding:16px 20px;font-size:12px}.note-tag{display:block;font:11px 'Courier New',monospace;margin-bottom:8px}.steps-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.quality-card{min-width:0;border-right:1px solid var(--line);padding:26px 20px}.quality-card:first-child{padding-left:0}.quality-card:last-child{padding-right:0;border-right:0}.step-header{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:22px;font:11px 'Courier New',monospace;color:var(--muted)}.step-tag{font-size:10px;text-align:right}.step-num{font-size:18px;color:var(--ink)}.card-media{margin-bottom:24px}.step-image{width:100%;height:155px;object-fit:cover;background:var(--white);filter:saturate(.75)}.media-caption{display:block;font:10px/1.5 'Courier New',monospace;color:var(--muted);padding:10px 0;border-bottom:1px solid var(--line)}.step-title{font-size:20px;line-height:1.25;margin-bottom:16px;overflow-wrap:anywhere}.step-desc{font-size:13px;line-height:1.7}
@media(max-width:1050px){.steps-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.quality-card{padding:26px 24px!important;border-bottom:1px solid var(--line)}.quality-card:nth-child(2n){border-right:0}.quality-card:nth-last-child(-n+2){border-bottom:0}.head-right{max-width:none}}@media(max-width:760px){.quality-testing-section{padding:55px 0}.head-right{margin-top:22px}.step-image{height:180px}}@media(max-width:480px){.steps-grid{grid-template-columns:1fr}.quality-card{padding:28px 0!important;border-right:0}.quality-card:nth-last-child(2){border-bottom:1px solid var(--line)}.step-image{height:200px}}
</style>
