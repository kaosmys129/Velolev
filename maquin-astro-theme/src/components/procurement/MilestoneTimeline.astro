---
import {aboutFor} from "../../lib/about-content.mjs";
const {locale="en"}=Astro.props;
const copy=aboutFor(locale),current=copy.locale;
const data=copy.timeline;
---

<section class="milestone-timeline-section" id="engineering-timeline">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h2>{data.title}</h2>
      </div>
      <p class="muted">{data.lead}</p>
    </div>

    <div class="timeline-container">
      <div class="timeline-track" aria-hidden="true"></div>
      <div class="timeline-nodes">
        {data.milestones.map((node, index) => (
          <div class="timeline-item">
            <div class="timeline-marker" aria-hidden="true">
              <span class="marker-dot"></span>
            </div>
            <article class="timeline-card">
              <div class="card-meta">
                <span class="meta-stage">{node.stage}</span>
                <span class="meta-period">{node.period}</span>
              </div>
              <h3 class="card-title">{node.title}</h3>
              <p class="card-desc muted">{node.desc}</p>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .milestone-timeline-section {
    padding: 90px 0;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
  }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 60px;
  }

  .timeline-container {
    position: relative;
    padding-left: 36px;
  }

  .timeline-track {
    position: absolute;
    left: 8px;
    top: 10px;
    bottom: 20px;
    width: 2px;
    background: var(--line);
  }

  .timeline-nodes {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .timeline-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-width: 0;
    max-width: 100%;
  }

  .timeline-marker {
    position: absolute;
    left: -36px;
    top: 24px;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    background: var(--yellow);
    border: 2px solid var(--ink);
    border-radius: 2px;
    box-shadow: 0 0 0 4px #ffffff;
  }

  .timeline-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 28px;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .timeline-card:hover {
    border-color: var(--yellow);
    transform: translateX(4px);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .meta-stage {
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 12px;
    font-weight: 700;
    background: var(--ink);
    color: var(--white);
    padding: 3px 8px;
    border-radius: 2px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-period {
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .card-title {
    font-size: 20px;
    font-weight: 650;
    line-height: 1.3;
    margin-bottom: 12px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1050px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 760px) {
    .milestone-timeline-section {
      padding: 55px 0;
    }

    .timeline-container {
      padding-left: 28px;
    }

    .timeline-track {
      left: 6px;
    }

    .timeline-marker {
      left: -28px;
    }

    .timeline-card {
      padding: 20px;
    }

    .timeline-card:hover {
      transform: none;
    }
  }
</style>
