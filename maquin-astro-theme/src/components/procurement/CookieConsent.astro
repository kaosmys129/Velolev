---
/**
 * velolev 工业机械 - GDPR / ePrivacy Cookie 政策与偏好设置组件
 * 
 * 特性：
 * 1. 严格遵循 GDPR / ePrivacy 规范，默认阻止非必要 Cookie，提供粒度化选项；
 * 2. 7 语种完整支持 (en, es, fr, pt, vi, th, id)，自动生成对应语言的 Privacy Notice 链接；
 * 3. 状态持久化于 localStorage 与 Cookie (velolev_cookie_consent)，避免重复弹出；
 * 4. 平滑的 CSS Transform & Opacity 入场与退场动画，无首屏闪烁 (FOUC)；
 * 5. 完善的无障碍设计 (a11y)：符合 WAI-ARIA 规范、Esc 快捷关闭、Tab 键焦点流与高对比度焦点环；
 * 6. 对外暴露 window.velolevCookieConsent 全局 API 及 'velolev:cookie-consent' 自定义事件。
 */
import { localizedPagePath } from "../../lib/site-config.mjs";

interface Props {
  locale?: string;
  privacyUrl?: string;
  position?: "bottom-right" | "bottom";
  variant?: "card" | "banner";
}

const {
  locale = "en",
  privacyUrl,
  position = "bottom-right",
  variant = "card"
} = Astro.props;

const supportedLocales = ["en", "es", "fr", "pt", "vi", "th", "id"] as const;
type SupportedLocale = typeof supportedLocales[number];
const currentLocale: SupportedLocale = supportedLocales.includes(locale as SupportedLocale)
  ? (locale as SupportedLocale)
  : "en";

// 自动生成当前语言下的隐私政策路径
let resolvedPrivacyUrl = privacyUrl;
if (!resolvedPrivacyUrl) {
  try {
    resolvedPrivacyUrl = localizedPagePath("privacy", currentLocale) || (currentLocale === "en" ? "/privacy/" : `/${currentLocale}/privacy/`);
  } catch {
    resolvedPrivacyUrl = currentLocale === "en" ? "/privacy/" : `/${currentLocale}/privacy/`;
  }
}

// 7 语种国际化文案字典
