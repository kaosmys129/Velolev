---
import baseline from "../../data/content-baseline.json";
import EquipmentVisual from "./EquipmentVisual.astro";
import SpecStrip from "./SpecStrip.astro";
import JobSiteCards from "./JobSiteCards.astro";
import MediaFigure from "./MediaFigure.astro";
import EquipmentFilm from "./EquipmentFilm.astro";
const {locale="en"}=Astro.props;
const s=baseline.product.specifications;
---
<main id="main">
  <section class="hero"><div class="wrap">
    <div class="hero-grid"><div class="hero-copy"><p class="eyebrow">Portable light pole lifter</p><h1>Erect 12m Light Poles<br/>Without a Crane.</h1><p class="lead muted">The 85 kg split-hydraulic lifter engineered to slash installation costs by up to 70%. Built for 2-man crews operating in tight sidewalks, parking lots, and remote solar roadways.</p><div class="actions"><a class="button" href="/products/light-pole-jack/">Explore Equipment Specifications <span aria-hidden="true">↗</span></a><a class="text-link" href="/tools/roi-calculator/">Calculate Project Cost Savings →</a></div></div><EquipmentVisual/></div>
    <SpecStrip/><p class="note">Standard 12 m class lifter specifications. Tailored adapter plates available for non-standard bolt circles.</p>
  </div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">The equipment</p><h2>Two modular units.<br/>Engineered for jobsite mobility.</h2></div><p class="muted">The hydraulic lifting module and electrical cabinet form an integrated mobile system. Review the dimensions, included components, and base connection details for your project.</p></div>
    <div class="two-column module-showcase"><div><MediaFigure src="/images/evidence/equipment-trolley-side-detail.jpg" alt="Close reference view of the hydraulic pump and wheeled lifting frame" label="01 / Hydraulic detail" caption="Equipment detail reference · Confirm the actual supplied components."/><div class="module-copy"><p class="section-number">01 / HYDRAULIC MODULE</p><h3>The lifting assembly</h3><p class="muted" style="margin-top:15px">Hydraulic cylinder, valve, oil pump and pressure gauge. The sheet lists a {s.hydraulicModuleWeightKg} kg module measuring {s.hydraulicModuleDimensionsMm.join(" × ")} mm.</p></div></div><div><MediaFigure src="/images/product/portable-pole-lifter-hero-cutout.png" alt="Lifting assembly beside its separate yellow electrical cabinet" label="02 / System overview" caption="Product reference · Hydraulic assembly and separate electrical cabinet." variant="cutout"/><div class="module-copy"><p class="section-number">02 / ELECTRICAL CABINET</p><h3>Power and control</h3><p class="muted" style="margin-top:15px">Control system, rechargeable {s.batteryVoltageV} V battery, ammeter, voltage meter and lift buttons. Cabinet dimensions: {s.electricalCabinetDimensionsMm.join(" × ")} mm.</p></div></div></div>
    <a class="text-link" style="margin-top:35px" href="/products/light-pole-jack/#specifications">See the complete specifications <span aria-hidden="true">→</span></a>
  </div></section>
  <section class="section film-section" id="equipment-overview"><div class="wrap"><div class="section-head"><div><p class="eyebrow">In focus / Equipment film</p><h2>A closer look.<br/>From frame to detail.</h2></div><p class="muted">Take a short visual tour of the equipment, hydraulic detail, connection and packing. Select a chapter to look closer.</p></div><EquipmentFilm locale={locale} id="home-equipment-film"/></div></section>
  <section class="section" style="background:#fff; border-top:1px solid var(--line); border-bottom:1px solid var(--line);"><div class="wrap"><div class="section-head"><div><p class="eyebrow">Application Showcase / Field Reliability</p><h2>Proven on Real Jobsites.<br/>Built for Tough Access.</h2></div><p class="muted">Engineered for urban footpaths, dense parking facilities, and remote off-grid solar lighting where heavy mobile cranes cannot operate.</p></div><JobSiteCards limit={3}/></div></section>
  <section class="section dark-section"><div class="wrap two-column"><div><p class="eyebrow">Before the lift</p><h2>Height is only<br/>the starting point.</h2><p class="lead muted" style="margin-top:24px">A pole's assembled weight, flange, anchor bolts and foundation all matter. A matching height alone does not confirm compatibility.</p><div class="actions"><a class="button" href="/guides/pole-jack-compatibility/">Check the information you need <span aria-hidden="true">↗</span></a></div></div><div class="yellow-panel"><p class="eyebrow">Turnkey Fit Assurance</p><h3>Zero-Risk Jobsite Fit.<br/>Direct Engineering Review.</h3><ul><li>Pole height & assembled payload verification (≤300 kg)</li><li>Base flange drawing & anchor bolt pattern matching</li><li>Sidewalk access & ground leveling alignment</li><li>Turnkey dispatch documentation & export support</li></ul><p>Send your base drawing or bolt-circle measurements. Our senior engineering team verifies compatibility within 24 hours.</p></div></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><p class="eyebrow">A practical next step</p><h2>From specifications<br/>to your project.</h2></div><p class="muted">For electrical contractors, road-lighting teams and project procurement. Commercial terms are discussed privately after the application and configuration are reviewed.</p></div>
    <div class="step-row"><span>01</span><h3>Review the equipment</h3><p>Look at the rated load, module dimensions and standard included configuration. Verified specifications ensure field safety.</p></div>
    <div class="step-row"><span>02</span><h3>Collect the project details</h3><p>Use the compatibility guide to prepare pole, flange and foundation dimensions. Our engineers support non-standard base patterns.</p></div>
    <div class="step-row"><span>03</span><h3>Request a configuration review</h3><p>Submit your details and optional drawing. Our mechanical team provides turnkey compatibility analysis within 24 business hours.</p></div>
    <div class="cta-band" style="margin-top:40px"><h2>Let's start with<br/>the pole you need to install.</h2><a class="button" href="/quote/">Request a project quote <span aria-hidden="true">↗</span></a></div>
  </div></section>
</main>
<style>
  .module-showcase{gap:32px}.module-copy{padding-top:26px}.module-copy .section-number{margin-bottom:12px}.film-section{padding-top:0}
  @media(max-width:760px){.module-showcase{gap:40px}}
</style>
