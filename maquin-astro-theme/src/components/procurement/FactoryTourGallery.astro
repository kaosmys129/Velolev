---
import {aboutFor} from "../../lib/about-content.mjs";
const {locale="en"}=Astro.props;const data=aboutFor(locale).facility;
---
<section class="factory-tour-section" id="facility-tour"><div class="wrap">
 <div class="section-head"><div><p class="eyebrow">{data.eyebrow}</p><h2>{data.title}</h2></div><p class="muted">{data.lead}</p></div>
 <div class="tour-grid">{data.items.map((item,index)=><article class="tour-card"><a class="card-media" href={item.image} data-media-image data-caption={item.description} aria-label={item.title}><span class="view-tag">0{index+1} / {item.tag}</span><img src={item.image} alt={item.title} width="600" height="400" loading="lazy"/><span class="tour-expand" aria-hidden="true">↗</span></a><div class="card-body"><h3 class="card-title">{item.title}</h3><p class="card-desc muted">{item.description}</p></div></article>)}</div>
 <div class="facility-metrics-strip">{data.metrics.map(metric=><div class="metric-item"><span class="metric-val">{metric.value} kg</span><span class="metric-label">{metric.label}</span></div>)}</div>
</div></section>
<style>
  .factory-tour-section {
    padding: 90px 0;
    border-top: 1px solid var(--line);
    background: #ffffff;
  }

  .section-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 50px;
  }

  .tour-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .tour-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 2px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .tour-card:hover {
    border-color: var(--yellow);
    transform: translateY(-2px);
  }

  .card-media {
    display:block;
    position: relative;
    background: var(--green);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .tour-expand{position:absolute;right:12px;bottom:12px;width:36px;height:36px;display:grid;place-items:center;background:var(--yellow);color:var(--ink);font-size:22px;z-index:2}

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .tour-card:hover .card-media img {
    transform: scale(1.02);
  }

  .view-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: rgba(29, 32, 30, 0.88);
    color: var(--white);
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-size: 20px;
    font-weight: 650;
    line-height: 1.3;
    margin-bottom: 12px;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .facility-metrics-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
  }

  .metric-item {
    padding: 16px 20px;
    background: var(--paper);
    border-left: 3px solid var(--yellow);
    border-radius: 2px;
  }

  .metric-val {
    display: block;
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .metric-label {
    display: block;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 1050px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 760px) {
    .factory-tour-section {
      padding: 55px 0;
    }

    .tour-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .facility-metrics-strip {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
