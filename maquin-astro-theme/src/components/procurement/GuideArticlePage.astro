    faqSectionTitle: "คำถามที่พบบ่อยเกี่ยวกับการติดตั้งเสาไฟโดยไม่ใช้รถเครน",
    eeatAccountabilityLabel: "ความรับผิดชอบทางวิศวกรรมและการตรวจสอบ:",
    eeatReviewer: "volvet Engineering Review",
    eeatComplianceLabel: "ขอบเขตมาตรฐานและการปฏิบัติตามข้อกำหนด:",
    eeatFactLabel: "บันทึกภาคสนามและพารามิเตอร์การทดสอบจริง:",
    eeatCaseBrief: "เกณฑ์มาตรฐานทางวิศวกรรม: พิกัดยกปลอดภัย 300 กก. WLL, โครงสร้างแยกส่วน 85 กก. (กระบอกยก 45 กก., ตู้ควบคุม 40 กก.; ชิ้นส่วนหนักสุดไม่เกิน 65 กก.), รองรับระยะพิทช์ 200–450 มม. (P.C.D.) และชุดขับเคลื่อนไฮดรอลิก 24V บันทึกการตรวจสอบหน้างานจริงและใบรับรองการทดสอบจะเผยแพร่เมื่อผ่านการตรวจรับขั้นสุดท้าย"
  },
  id: {
    directAnswerBadge: "Jawaban Rekayasa Langsung / Ringkasan Eksekutif",
    directAnswerText: "Tiang lampu jalan perkotaan setinggi 12m (beban terukur 300kg) dapat dipasang secara aman tanpa truk derek melalui alat hidrolik portabel yang menambatkan diri pada baut angkur pondasi M16–M24. Kelayakan teknis harus dikonfirmasi berdasarkan berat total, pusat gravitasi, ambang batas angin, dan jarak aman listrik.",
    specLabelLimit: "Batas Beban Kerja Aman (WLL)",
    specCapacity: "300 kg Beban Maksimal (Hingga 12m)",
    specLabelCrew: "Kebutuhan Tenaga Kerja",
    specCrew: "2 Operator (85kg modular)",
    specLabelBolt: "Pola Lingkaran Baut Angkur",
    specAnchorage: "P.C.D. 180–260 mm (ASTM F1554)",
    specLabelPower: "Daya & Sistem Mekanis",
    specPower: "Baterai 24V DC (Sistem tertutup)",
    tableCaption: "Tabel 1: Perbandingan Operasional: Alat Angkat Tiang Portabel vs. Truk Derek Boom 16 Ton",
    colMetric: "Parameter Rekayasa",
    colLifter: "Alat Angkat Portabel volvet",
    colCrane: "Truk Derek Boom 16 Ton",
    tableRows: [
      { metric: "Akses Lokasi & Koridor Sempit", lifter: "Jalur pejalan kaki, trotoar, ladang surya tanpa aspal (tanpa merusak tanah)", crane: "Membutuhkan lebar jalan aspal minimal 6m dan tanah padat untuk kaki outrigger" },
      { metric: "Kebutuhan Tenaga & Pelatihan", lifter: "2 operator terlatih (transportasi modular 85kg dengan mobil pikap biasa)", crane: "3 hingga 4 personel (operator derek bersertifikat, rigger, dan pemandu sinyal)" },
      { metric: "Jarak Bebas terhadap Kabel Udara", lifter: "Pengangkatan dari bawah meminimalkan risiko busur api listrik (IEEE 516 / OSHA 1926)", crane: "Risiko sengatan listrik tinggi: butuh pemadaman jaringan atau jarak bebas besar" },
      { metric: "Penambatan pada Pondasi Beton", lifter: "Penambatan kaku mandiri pada baut angkur ASTM F1554 P.C.D. 180–260mm", crane: "Mengandalkan penyeimbang beban kendaraan; tekanan tanah setempat sangat tinggi" },
      { metric: "Izin Lalu Lintas & Mobilisasi", lifter: "Dapat mengurangi kebutuhan izin penutupan jalan; siap beroperasi dalam 15 menit", crane: "Izin penutupan jalur rumit, pemasangan rambu pengalihan dan biaya sewa mahal" }
    ],
    ctaAuditTitle: "Memiliki gambar flensa khusus atau ruang kerja sempit?",
    ctaAuditDesc: "Kirimkan dimensi pelat dasar dan gambar pondasi untuk peninjauan kompatibilitas teknis cepat dalam 24 jam.",
    ctaAuditBtn: "Minta Peninjauan Gambar 24 Jam ↗",
    ctaRoiBtn: "Hitung Penghematan Proyek dengan Kalkulator ROI ↗",
    reviewBadge: "Tinjauan Rekayasa Lengkap",
    reviewStandards: "Standar yang Diterapkan: ASTM F1554, ANSI/IES RP-8-18, OSHA 1926 Subpart CC, IEEE 516, EN 40-3",
    breadcrumbGuide: "Panduan",
    breadcrumbReviewed: "Artikel terverifikasi",
    eyebrowPrefix: "Konten berbasis rekayasa",
    relatedTitle: "Panduan teknis dan alat perencanaan terkait",
    faqSectionTitle: "Pertanyaan umum seputar pemasangan tiang lampu tanpa derek",
    eeatAccountabilityLabel: "Akuntabilitas Teknis dan Verifikasi Rekayasa:",
    eeatReviewer: "volvet Engineering Review",
    eeatComplianceLabel: "Cakupan Standar dan Kepatuhan Keselamatan:",
    eeatFactLabel: "Berkas Lapangan dan Parameter Uji Terverifikasi:",
    eeatCaseBrief: "Garis dasar rekayasa: WLL 300 kg terverifikasi, sistem modular 85 kg (tiang 45 kg, kabinet daya 40 kg; paket terberat 65 kg), lingkaran baut flensa 200–450 mm (P.C.D.), dan paket tenaga hidrolik 24V. Dokumen validasi lapangan dan sertifikat uji akan diterbitkan setelah pembukaan gerbang validasi resmi."
  }
};

const c = copyMap[locale] || copyMap.en;
const guidesIndexPath = locale === "en" ? "/guides/" : localizedPagePath("guides", locale);
const quotePath = locale === "en" ? "/quote/" : localizedPagePath("quote", locale);
const roiPath = locale === "en" ? "/tools/roi-calculator/" : localizedPagePath("roi", locale);
const compPath = locale === "en" ? "/guides/pole-jack-compatibility/" : localizedPagePath("compatibility", locale);

const rawSeoTitle = locArticle?.seoTitle || article.seoTitle || article.title;
const seoTitle = /\|\s*volvet/i.test(rawSeoTitle) ? rawSeoTitle : `${rawSeoTitle} | volvet`;

const origin = publicOrigin();
const articleImg = heroCoverImage || "/images/product/portable-pole-lifter-hero-cutout.png";
const absImage = origin ? new URL(articleImg, origin).href : articleImg;
const pageUrl = origin ? canonicalUrl(currentPath, origin) : currentPath;

const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": article.title,
  "description": article.description,
  "inLanguage": locale,
  "datePublished": "2026-10-28",
  "dateModified": rawArticle.review?.reviewedAt || "2026-11-03",
  "image": absImage,
  "author": {
    "@type": "Organization",
    "name": "volvet Engineering Review",
    ...(origin ? { "url": origin } : {})
  },
  "publisher": {
    "@type": "Organization",
    "name": "volvet",
    ...(origin ? {
      "url": origin,
      "logo": {
        "@type": "ImageObject",
        "url": `${origin}/brand/volvet-wordmark.svg`
      }
    } : {})
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  }
};
---
<Layout page="guides" locale={locale} article={{ ...meta, title: seoTitle, heroCoverImage }} extraSchemas={[techArticleSchema]}>
  <main id="main">
    <div class="wrap">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <p class="breadcrumb"><a href={guidesIndexPath}>{c.breadcrumbGuide}</a> / {c.breadcrumbReviewed}</p>
      </nav>
      
      <header class="page-intro">
        <p class="eyebrow">{c.eyebrowPrefix} / {rawArticle.review.reviewedAt}</p>
        <h1>{h1Text}</h1>
        <p class="lead muted">{article.description}</p>
      </header>

      {heroCoverImage ? (
        <div class="hero-figure-wrapper">
          <MediaFigure
            src={heroCoverImage}
            alt={fm.heroCoverAlt}
            label={fm.heroCoverLabel}
            caption={fm.heroCoverCaption}
            eager
            class="article-infographic"
          />
        </div>
      ) : imageFolder && (
        <div class="hero-figure-wrapper">
          <MediaFigure
            src={`/images/${imageFolder}/01-feature-hero-cover-16x9.png`}
            alt={fm.heroCoverAlt}
            label={fm.heroCoverLabel}
            caption={fm.heroCoverCaption}
            eager
            class="article-infographic"
          />
        </div>
      )}

      <!-- Direct Answer Box (Google Featured Snippet Anchor) -->
      <aside class="direct-answer-box" aria-label="Technical Direct Answer">
        <div class="direct-answer-header">
          <span class="direct-answer-badge">✓ {c.directAnswerBadge}</span>
        </div>
        <p class="direct-answer-text">
          <strong>{c.directAnswerText}</strong>
        </p>
        <div class="direct-answer-specs">
          <div class="spec-card">
            <span class="spec-label">{c.specLabelLimit}</span>
            <span class="spec-value">{c.specCapacity}</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">{c.specLabelCrew}</span>
            <span class="spec-value">{c.specCrew}</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">{c.specLabelBolt}</span>
            <span class="spec-value">{c.specAnchorage}</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">{c.specLabelPower}</span>
            <span class="spec-value">{c.specPower}</span>
          </div>
        </div>
      </aside>

      <article class="policy-body snapshot-article">
        {(() => {
          let hasRenderedFaqHeader = false;
          let hasRenderedComparisonTable = false;
          return article.sections.map((s, idx) => {
            const fig = getSectionFigure(s.heading, imageFolder);
            const isSub = isSubHeading(s.heading);
            const isFaq = isSub && s.heading.includes("?");
            const shouldRenderFaqHeader = isFaq && !hasRenderedFaqHeader;
            if (shouldRenderFaqHeader) {
              hasRenderedFaqHeader = true;
            }

            const shouldRenderComparisonTable = !hasRenderedComparisonTable && (
              Boolean(fig && (fig.id === "05" || fig.src.includes("05-crane-vs-lifter-comparison"))) ||
              idx === 1 ||
              (idx === 0 && article.sections.length === 1)
            );
            if (shouldRenderComparisonTable) {
              hasRenderedComparisonTable = true;
            }

            return (
              <>
                {shouldRenderFaqHeader && (
                  <section class="article-section primary-section faq-heading-section">
                    <h2>{c.faqSectionTitle}</h2>
                  </section>
                )}
                <section class={`article-section ${isSub ? 'sub-section' : 'primary-section'} ${isFaq ? 'faq-item' : ''}`}>
              {isSub ? (
                <h3>{s.heading}</h3>
              ) : (
                <h2>{s.heading}</h2>
              )}

              {fig && (
                <MediaFigure
                  src={fig.src}
                  alt={fig.alt}
                  label={fig.label}
                  caption={fig.caption}
                  class="article-infographic"
                />
              )}

              {/* 在对比图下方渲染语义化工程数据表格 */}
              {shouldRenderComparisonTable && (
                <div class="table-responsive-container">
                  <table class="engineering-data-table">
                    <caption>{c.tableCaption}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{c.colMetric}</th>
                        <th scope="col">{c.colLifter}</th>
                        <th scope="col">{c.colCrane}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {c.tableRows.map(row => (
                        <tr>
                          <th scope="row">{row.metric}</th>
                          <td>{row.lifter}</td>
                          <td>{row.crane}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {/* 使用专用 AST Markdown 渲染器解析段落 */}
              <div class="section-content" set:html={renderMarkdownBlock(s.paragraphs.join("\n\n"))} />

              {/* 在法兰适配或第三节后插入高转化图纸审计 CTA */}
              {idx === 3 && (
                <div class="interactive-b2b-cta-card">
                  <div class="cta-card-content">
                    <h3>{c.ctaAuditTitle}</h3>
                    <p>{c.ctaAuditDesc}</p>
                    <div class="cta-actions">
                      <a class="button button--primary" href={`${quotePath}?context=flange-audit`}>{c.ctaAuditBtn}</a>
                      <a class="button button--secondary" href={roiPath}>{c.ctaRoiBtn}</a>
                    </div>
                  </div>
                </div>
              )}
            </section>
              </>
            );
          });
        })()}

        <!-- E-E-A-T Review & Provenance Authority Card -->
        <div class="eeat-authority-card">
          <div class="eeat-badge">✓ {c.reviewBadge}</div>
          <div class="eeat-body">
            <p><strong>{c.eeatAccountabilityLabel}</strong> {c.eeatReviewer}.</p>
            <p><strong>{c.eeatComplianceLabel}</strong> {c.reviewStandards}.</p>
            <p><strong>{c.eeatFactLabel}</strong> {c.eeatCaseBrief}</p>
            <p class="muted">Fact Register: {rawArticle.evidenceRefs.join(", ")} &bull; Baseline Version: {rawArticle.review.baselineVersion} &bull; Specification-Only Baseline (Field Validation Pending) &bull; ASTM F1554 Anchor Foundation Design.</p>
          </div>
        </div>

        <div class="related-links-grid">
          <h3>{c.relatedTitle}</h3>
          <div class="links-row">
            {article.relatedPaths.map((p) => {
              const key = pageKeyForPath(p);
              const baseLabel = key && corePages[key]
                ? corePages[key].title.replace(/\s*\|\s*volvet.*$/i, "").trim()
                : p.replace(/^\/|\/$/g, "").replace(/-/g, " ");
              const label = locale === "en" ? baseLabel : translateText(baseLabel, locale);
              return (
                <a class="related-link-chip" href={localizePath(p, locale)}>
                  <span>{label}</span>
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              );
            })}
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>

<style>
  .hero-figure-wrapper {
    margin: 28px 0 40px;
    max-width: 960px;
  }
  .article-infographic {
    margin: 28px 0 36px;
  }
  .article-infographic :global(.media-figure-image) {
    aspect-ratio: 16 / 9;
    background: #171d18;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .article-infographic :global(.media-figure-image img) {
    object-fit: contain;
  }

  /* Direct Answer Box (Google Featured Snippet Optimized) */
  .direct-answer-box {
    background: #f7f9f6;
    border: 1px solid #d4ded3;
    border-left: 4px solid #2d6a4f;
    border-radius: 6px;
    padding: 24px;
    margin: 32px 0 44px;
  }
  .direct-answer-header {
    margin-bottom: 12px;
  }
  .direct-answer-badge {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #2d6a4f;
  }
  .direct-answer-text {
    font-size: 17px;
    line-height: 1.6;
    color: #1a2e22;
    margin-bottom: 20px;
  }
  .direct-answer-specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid #e1e8df;
  }
  .spec-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .spec-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #526658;
    font-weight: 600;
  }
  .spec-value {
    font-size: 14px;
    font-weight: 700;
    color: #1a2e22;
  }

  /* Engineering Table Styles */
  .table-responsive-container {
    overflow-x: auto;
    margin: 28px 0 36px;
    border: 1px solid var(--line, #d8e2dc);
    border-radius: 6px;
    background: #ffffff;
  }
  .engineering-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }
  .engineering-data-table caption {
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 700;
    color: #334e40;
    text-align: left;
    background: #f4f7f4;
    border-bottom: 1px solid var(--line, #d8e2dc);
  }
  .engineering-data-table th,
  .engineering-data-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #ebf0ec;
    vertical-align: top;
    line-height: 1.5;
  }
  .engineering-data-table thead th {
    background: #f9fbf9;
    font-weight: 700;
    color: #1c3124;
    border-bottom: 2px solid var(--line, #d8e2dc);
  }
  .engineering-data-table tbody th {
    font-weight: 600;
    color: #243d2d;
    background: #fafcfa;
    width: 25%;
  }
  .engineering-data-table tbody td {
    color: #3d5244;
  }
  .engineering-data-table tbody tr:hover td {
    background: #f8faf8;
  }

  /* Interactive B2B CTA Card */
  .interactive-b2b-cta-card {
    background: linear-gradient(135deg, #f1f6f2 0%, #e8f0ea 100%);
    border: 1px solid #c2d6c6;
    border-radius: 8px;
    padding: 28px 32px;
    margin: 40px 0;
  }
  .cta-card-content h3 {
    margin: 0 0 8px;
    font-size: 20px;
    color: #163020;
  }
  .cta-card-content p {
    margin: 0 0 20px;
    font-size: 15px;
    color: #3c5443;
    max-width: 680px;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* E-E-A-T Review Authority Card */
  .eeat-authority-card {
    background: #ffffff;
    border: 1px solid #cbdcd0;
    border-radius: 6px;
    padding: 20px 24px;
    margin: 48px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .eeat-badge {
    font-size: 13px;
    font-weight: 700;
    color: #205c3b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .eeat-body p {
    margin: 0 0 6px;
    font-size: 13px;
    line-height: 1.5;
    color: #2b4233;
  }
  .eeat-body p.muted {
    color: #63786a;
    font-size: 12px;
    margin-bottom: 0;
  }

  .article-section {
    margin-bottom: 40px;
  }
  .primary-section h2 {
    font-size: 24px;
    margin-top: 36px;
    margin-bottom: 16px;
    color: #122217;
  }
  .sub-section h3 {
    font-size: 19px;
    margin-top: 28px;
    margin-bottom: 12px;
    color: #1c3625;
  }
  .faq-item {
    border-bottom: 1px solid #e7ede8;
    padding-bottom: 24px;
  }
  .section-content :global(p) {
    font-size: 16px;
    line-height: 1.7;
    color: #2d3b32;
    margin-bottom: 16px;
  }
  .section-content :global(a) {
    color: #1d6a40;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }
  .section-content :global(a:hover) {
    color: #124327;
  }
  .section-content :global(ul.semantic-bullet-list),
  .section-content :global(ol.semantic-ordered-list) {
    margin: 16px 0 24px 20px;
    padding: 0;
  }
  .section-content :global(ul.semantic-bullet-list li),
  .section-content :global(ol.semantic-ordered-list li) {
    font-size: 15px;
    line-height: 1.6;
    color: #2d3b32;
    margin-bottom: 8px;
  }
  .section-content :global(blockquote.engineering-callout) {
    background: #f7f9f7;
    border-left: 4px solid #2d6a4f;
    margin: 24px 0;
    padding: 16px 20px;
    border-radius: 0 4px 4px 0;
  }
  .section-content :global(blockquote.engineering-callout h3) {
    margin-top: 0;
    margin-bottom: 12px;
    font-size: 17px;
    color: #1f3d2a;
  }
  .related-links-grid {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--line, #d8e2dc);
  }
  .related-links-grid h3 {
    font-size: 18px;
    margin-bottom: 16px;
    color: #1a2e22;
  }
  .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .related-link-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: #f4f7f4;
    border: 1px solid #d4ded3;
    border-radius: 20px;
    font-size: 13px;
    color: #254231;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .related-link-chip:hover {
    background: #e8f0e9;
    border-color: #2d6a4f;
    color: #1a2e22;
  }
</style>
