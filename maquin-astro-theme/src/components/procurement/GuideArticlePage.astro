---
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import Layout from "../../layouts/ProcurementLayout.astro";
import MediaFigure from "./MediaFigure.astro";
import { industrialLocales, localizedPagePath, publicOrigin, canonicalUrl, corePages, pageKeyForPath, localizePath, articleAlternates } from "../../lib/site-config.mjs";
import { translateText } from "../../lib/industrial-localization.mjs";
import localizedContent from "../../data/published-content-locales.json";
import { loadPublishedSnapshot } from "../../lib/reviewed-snapshot.mjs";
import { renderMarkdownBlock } from "../../lib/render-markdown.mjs";

const { article: rawArticle, locale = "en" } = Astro.props;
const isCraneExplainer = rawArticle.slug === "install-12m-street-light-poles-without-crane";

// 读取本地化文章数据（若存在）
const locArticle = locale !== "en" && localizedContent[locale]?.[rawArticle.slug]
  ? localizedContent[locale][rawArticle.slug]
  : null;

const article = {
  ...rawArticle,
  title: locArticle?.title || rawArticle.title,
  h1: locArticle?.h1 || rawArticle.h1,
  description: locArticle?.description || rawArticle.description,
  sections: locArticle?.sections || rawArticle.sections
};

const h1Text = locArticle?.h1 || article.h1 || article.title.replace(/\s*\|\s*velolev.*$/i, "");

const currentPath = locale === "en" ? `/guides/${article.slug}/` : `/${locale}/guides/${article.slug}/`;

const meta = {
  path: currentPath,
  title: locArticle?.seoTitle || rawArticle.seoTitle || (article.title.includes("|") ? article.title : `${article.title} | velolev`),
  description: locArticle?.seoDescription || rawArticle.seoDescription || article.description,
  alternates: articleAlternates(article.slug, { articles: [rawArticle], localesMap: localizedContent })
};

// 检测信息图资源（仅首篇 12 m 指南回退历史文件夹，避免后续文章误挂载）
const repoPublicImages = path.resolve(process.cwd(), "public/images");
const publicBase = fs.existsSync(repoPublicImages)
  ? repoPublicImages
  : path.resolve(process.cwd(), "maquin-astro-theme/public/images");
const candidates = [
  locArticle?.imageFolder,
  ...(isCraneExplainer ? [`portable-light-pole-lifter-explainer-${locale}`] : []),
  article.slug,
  `velolev-lifter-${article.slug}`,
  ...(isCraneExplainer ? ["velolev-lifter-task-based-deepseek-article"] : [])
].filter(Boolean);

let imageFolder = null;
for (const c of candidates) {
  if (fs.existsSync(path.join(publicBase, c, "01-feature-hero-cover-16x9.png"))) {
    imageFolder = c;
    break;
  }
}

// 检查封面大图 (cover-flow-hero-16x9.png)
let heroCoverImage = null;
if (imageFolder && fs.existsSync(path.join(publicBase, imageFolder, "cover-flow-hero-16x9.png"))) {
  heroCoverImage = `/images/${imageFolder}/cover-flow-hero-16x9.png`;
}

// 严格遵循 S4 规格基线的图注文本（移除未经证实的标准、吨位、现场实测与免费 24h 承诺）
const figureMap = {
