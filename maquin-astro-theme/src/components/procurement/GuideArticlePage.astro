    tableRows: [
      { metric: "Akses Lokasi & Area Tapak", lifter: "Angkut dua modul (modul hidrolik 45 kg + kabinet 40 kg) untuk jalur sempit dan area belum beraspal", crane: "Membutuhkan lebar akses jalan, daya dukung tanah, dan ruang kaki outrigger" },
      { metric: "Kru & Transportasi", lifter: "1–2 operator tercantum pada lembar spesifikasi; berat total peralatan 85 kg", crane: "Membutuhkan operator derek, tim rigging, dan pengiriman kendaraan berat" },
      { metric: "Ketinggian Kerja & Ruang Bebas", lifter: "Pemasangan di permukaan tanah; busur penuh tiang 12 m tetap memerlukan pemeriksaan kabel udara", crane: "Lengan derek udara memerlukan perencanaan ayunan boom dan jarak aman kabel listrik" },
      { metric: "Sambungan Pondasi & Flensa", lifter: "Dibaut ke angkur pondasi pada bentang 180–260 mm (M16–M22 disertakan, M24 tercantum; dudukan non-standar memerlukan peninjauan gambar berdimensi)", crane: "Ditopang outrigger derek saat menurunkan tiang ke baut pondasi" },
      { metric: "Lalu Lintas & Persiapan Lokasi", lifter: "Tapak ringkas mengurangi penutupan lajur bila diizinkan aturan lokasi", crane: "Sering memerlukan izin penutupan jalan, pengaturan lalu lintas, dan durasi sewa minimum" }
    ],
    ctaAuditTitle: "Memiliki Dudukan Non-Standar atau Ruang Lokasi Terbatas?",
    ctaAuditDesc: "Kirimkan tujuan proyek, ukuran pelat dasar, dan gambar pondasi untuk peninjauan kompatibilitas. Dudukan non-standar memerlukan peninjauan gambar berdimensi.",
    ctaAuditBtn: "Minta Peninjauan Konfigurasi ↗",
    ctaRoiBtn: "Bandingkan Biaya Proyek dengan Kalkulator ROI ↗",
    reviewBadge: "Artikel Ditinjau Berdasarkan Garis Dasar",
    reviewStandards: "Garis Dasar Sumber: Lembar Spesifikasi Produk (S4) · Register Fakta F001–F031 · Validasi Lapangan Tertunda",
    breadcrumbGuide: "Panduan",
    breadcrumbReviewed: "Artikel ditinjau",
    eyebrowPrefix: "Konten berbasis spesifikasi",
    relatedTitle: "Panduan teknis dan alat perencanaan terkait",
    faqSectionTitle: "Pertanyaan umum seputar pemasangan tiang lampu 12 m tanpa derek",
    eeatAccountabilityLabel: "Tinjauan Editorial & Teknik:",
    eeatReviewer: "velolev Engineering Review",
    eeatComplianceLabel: "Ruang Lingkup Bukti & Garis Dasar:",
    eeatFactLabel: "Ringkasan Garis Dasar Spesifikasi:",
    eeatCaseBrief: "Garis dasar spesifikasi: kelas tiang berlaku 12 m, beban terukur 300 kg, arsitektur dua modul 85 kg (modul hidrolik 45 kg, kabinet listrik 24 V 40 kg), bentang lubang flensa 180–260 mm, dan baut angkur M16–M24 tercantum (M16–M22 disertakan; dudukan non-standar memerlukan peninjauan gambar berdimensi). Angka laporan pabrikan 20 s, >50 angkatan per pengisian, dan >3000 siklus tetap berstatus label spesifikasi sambil menunggu validasi lapangan."
  }
};

const c = copyMap[locale] || copyMap.en;
const guidesIndexPath = locale === "en" ? "/guides/" : localizedPagePath("guides", locale);
const quotePath = locale === "en" ? "/quote/" : localizedPagePath("quote", locale);
const roiPath = locale === "en" ? "/tools/roi-calculator/" : localizedPagePath("roi", locale);
const compPath = locale === "en" ? "/guides/pole-jack-compatibility/" : localizedPagePath("compatibility", locale);

const rawSeoTitle = locArticle?.seoTitle || article.seoTitle || article.title;
const seoTitle = /\|\s*velolev/i.test(rawSeoTitle) ? rawSeoTitle : `${rawSeoTitle} | velolev`;
const snapshotArticles = loadPublishedSnapshot().articles;

const origin = publicOrigin();
const articleImg = heroCoverImage || "/images/product/portable-pole-lifter-hero-cutout.png";
const absImage = origin ? new URL(articleImg, origin).href : articleImg;
const pageUrl = origin ? canonicalUrl(currentPath, origin) : currentPath;
const datePublished = rawArticle.publishedAt || rawArticle.review?.reviewedAt || "2026-11-01";

const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": article.title,
  "description": article.description,
  "inLanguage": locale,
  "datePublished": datePublished,
  "dateModified": rawArticle.review?.reviewedAt || datePublished,
  "image": absImage,
  "author": {
    "@type": "Organization",
    "name": "velolev Engineering Review",
    ...(origin ? { "url": origin } : {})
  },
  "publisher": {
    "@type": "Organization",
    "name": "velolev",
    ...(origin ? {
      "url": origin,
      "logo": {
        "@type": "ImageObject",
        "url": `${origin}/brand/velolev-wordmark.svg`
      }
    } : {})
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  }
};

// 提取并构建 FAQPage Schema（赋能 Google FAQ Rich Snippets 与 Bing/ChatGPT 问答抽取）
const faqEntities = [];
if (Array.isArray(rawArticle.faq)) {
  for (const item of rawArticle.faq) {
    if (item.question && item.answer) {
      faqEntities.push({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      });
    }
  }
}

if (faqEntities.length === 0 && Array.isArray(article.sections)) {
  for (const s of article.sections) {
    const heading = (s.heading || "").trim();
    if (heading.includes("?") || heading.includes("？") || isSubHeading(heading)) {
      // 形式 1: 章节标题本身是问句
      if (s.paragraphs && s.paragraphs.length > 0) {
        const cleanAnswer = s.paragraphs.join(" ").replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").replaceAll("`", "").replace(/[*_#]/g, "");
        faqEntities.push({
          "@type": "Question",
          "name": heading,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": cleanAnswer
          }
        });
      }
    } else if (/faq|frequently asked/i.test(heading)) {
      // 形式 2: 章节是 FAQ 容器，段落采用 **Question?** Answer 格式
      if (Array.isArray(s.paragraphs)) {
        for (const p of s.paragraphs) {
          const match = p.match(/^\*\*([^*?？]+[?？])\*\*\s*([\s\S]+)$/);
          if (match) {
            const q = match[1].trim();
            const a = match[2].trim().replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").replaceAll("`", "").replace(/[*_#]/g, "");
            faqEntities.push({
              "@type": "Question",
              "name": q,
              "acceptedAnswer": {
                "@type": "Answer",
                "text": a
              }
            });
          }
        }
      }
    }
  }
}

const faqSchema = faqEntities.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqEntities
} : null;

const extraSchemas = [techArticleSchema, faqSchema].filter(Boolean);

// 提取动态 Direct Answer 首屏直接解答卡文案
const directAnswerBadge = locArticle?.directAnswerBadge || rawArticle.directAnswerBadge || c.directAnswerBadge;
const directAnswerText = locArticle?.directAnswerText || rawArticle.directAnswerText || (rawArticle.description ? rawArticle.description : c.directAnswerText);
---
<Layout page="guides" locale={locale} article={{ ...meta, title: seoTitle, heroCoverImage }} extraSchemas={extraSchemas}>
  <main id="main">
    <div class="wrap">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <p class="breadcrumb"><a href={guidesIndexPath}>{c.breadcrumbGuide}</a> / {c.breadcrumbReviewed}</p>
      </nav>
      
      <header class="page-intro">
        <p class="eyebrow">{c.eyebrowPrefix} / {rawArticle.review.reviewedAt}</p>
        <h1>{h1Text}</h1>
        <p class="lead muted">{article.description}</p>
      </header>

      {heroCoverImage ? (
        <div class="hero-figure-wrapper">
          <MediaFigure
            src={heroCoverImage}
            alt={fm.heroCoverAlt}
            label={fm.heroCoverLabel}
            caption={fm.heroCoverCaption}
            eager
            class="article-infographic"
          />
        </div>
      ) : imageFolder && (
        <div class="hero-figure-wrapper">
          <MediaFigure
            src={`/images/${imageFolder}/01-feature-hero-cover-16x9.png`}
            alt={fm.heroCoverAlt}
            label={fm.heroCoverLabel}
            caption={fm.heroCoverCaption}
            eager
            class="article-infographic"
          />
        </div>
      )}

      {/* 渲染动态参数摘要与直接回答卡片（赋能 Google Featured Snippets 与 AI 搜索 Direct Answer） */}
      <aside class="direct-answer-box" aria-label="Technical Direct Answer">
        <div class="direct-answer-header">
          <span class="direct-answer-badge">✓ {directAnswerBadge}</span>
        </div>
        <p class="direct-answer-text">
          <strong>{directAnswerText}</strong>
        </p>
        <div class="direct-answer-specs">
          <div class="spec-card">
            <span class="spec-label">{c.specLabelLimit}</span>
            <span class="spec-value">{c.specCapacity}</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">{c.specLabelCrew}</span>
            <span class="spec-value">{c.specCrew}</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">{c.specLabelBolt}</span>
            <span class="spec-value">{c.specAnchorage}</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">{c.specLabelPower}</span>
            <span class="spec-value">{c.specPower}</span>
          </div>
        </div>
      </aside>

      <article class="policy-body snapshot-article">
        {(() => {
          let hasRenderedFaqHeader = false;
          let hasRenderedComparisonTable = false;
          return article.sections.map((s, idx) => {
            const fig = getSectionFigure(s.heading, imageFolder);
            const isSub = isSubHeading(s.heading);
            const isFaq = isSub && s.heading.includes("?");
            const shouldRenderFaqHeader = isFaq && !hasRenderedFaqHeader;
            if (shouldRenderFaqHeader) {
              hasRenderedFaqHeader = true;
            }

            const shouldRenderComparisonTable = isCraneExplainer && !hasRenderedComparisonTable && (
              Boolean(fig && (fig.id === "05" || fig.src.includes("05-crane-vs-lifter-comparison"))) ||
              idx === 1 ||
              (idx === 0 && article.sections.length === 1)
            );
            if (shouldRenderComparisonTable) {
              hasRenderedComparisonTable = true;
            }

            return (
              <>
                {shouldRenderFaqHeader && (
                  <section class="article-section primary-section faq-heading-section">
                    <h2>{c.faqSectionTitle}</h2>
                  </section>
                )}
                <section class={`article-section ${isSub ? 'sub-section' : 'primary-section'} ${isFaq ? 'faq-item' : ''}`}>
              {isSub ? (
                <h3>{s.heading}</h3>
              ) : (
                <h2>{s.heading}</h2>
              )}

              {fig && (
                <MediaFigure
                  src={fig.src}
                  alt={fig.alt}
                  label={fig.label}
                  caption={fig.caption}
                  class="article-infographic"
                />
              )}

              {/* 在对比图下方渲染语义化工程数据表格 */}
              {shouldRenderComparisonTable && (
                <div class="table-responsive-container">
                  <table class="engineering-data-table">
                    <caption>{c.tableCaption}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{c.colMetric}</th>
                        <th scope="col">{c.colLifter}</th>
                        <th scope="col">{c.colCrane}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {c.tableRows.map(row => (
                        <tr>
                          <th scope="row">{row.metric}</th>
                          <td>{row.lifter}</td>
                          <td>{row.crane}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {/* 使用专用 AST Markdown 渲染器解析段落 */}
              <div class="section-content" set:html={renderMarkdownBlock(s.paragraphs.join("\n\n"))} />

              {/* 在法兰适配或第三节后插入配置核查 CTA */}
              {idx === 3 && (
                <div class="interactive-b2b-cta-card">
                  <div class="cta-card-content">
                    <h3>{c.ctaAuditTitle}</h3>
                    <p>{c.ctaAuditDesc}</p>
                    <div class="cta-actions">
                      <a class="button button--primary" href={`${quotePath}?context=flange-audit`}>{c.ctaAuditBtn}</a>
                      <a class="button button--secondary" href={roiPath}>{c.ctaRoiBtn}</a>
                    </div>
                  </div>
                </div>
              )}
            </section>
              </>
            );
          });
        })()}

        <!-- E-E-A-T Review & Provenance Authority Card -->
        <div class="eeat-authority-card">
          <div class="eeat-badge">✓ {c.reviewBadge}</div>
          <div class="eeat-body">
            <p><strong>{c.eeatAccountabilityLabel}</strong> {c.eeatReviewer}.</p>
            <p><strong>{c.eeatComplianceLabel}</strong> {c.reviewStandards}.</p>
            <p><strong>{c.eeatFactLabel}</strong> {c.eeatCaseBrief}</p>
            <p class="muted">Fact Register: {rawArticle.evidenceRefs.join(", ")} &bull; Baseline Version: {rawArticle.review.baselineVersion} &bull; Specification-Only Baseline (Field Validation Pending) &bull; Non-standard bases require a dimensioned drawing review.</p>
          </div>
        </div>

        <div class="related-links-grid">
          <h3>{c.relatedTitle}</h3>
          <div class="links-row">
            {article.relatedPaths.map((p) => {
              const key = pageKeyForPath(p);
              const guideSlug = p.match(/^\/guides\/([a-z0-9-]+)\/$/)?.[1];
              const matchedGuide = guideSlug ? snapshotArticles.find(item => item.slug === guideSlug) : null;
              const matchedGuideTitle = matchedGuide
                ? (locale !== "en" && localizedContent[locale]?.[guideSlug]?.title
                  ? localizedContent[locale][guideSlug].title
                  : matchedGuide.title).replace(/\s*\|\s*velolev.*$/i, "").trim()
                : null;
              const baseLabel = key && corePages[key]
                ? corePages[key].title.replace(/\s*\|\s*velolev.*$/i, "").trim()
                : (matchedGuideTitle || p.replace(/^\/|\/$/g, "").replace(/-/g, " "));
              const label = (locale === "en" || matchedGuideTitle) ? baseLabel : translateText(baseLabel, locale);
              return (
                <a class="related-link-chip" href={localizePath(p, locale)}>
                  <span>{label}</span>
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              );
            })}
          </div>
        </div>
      </article>
    </div>
  </main>
</Layout>

<style>
  .hero-figure-wrapper {
    margin: 28px 0 40px;
    max-width: 960px;
  }
  .article-infographic {
    margin: 28px 0 36px;
  }
  .article-infographic :global(.media-figure-image) {
    aspect-ratio: 16 / 9;
    background: #171d18;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .article-infographic :global(.media-figure-image img) {
    object-fit: contain;
  }

  /* Direct Answer Box (Google Featured Snippet Optimized) */
  .direct-answer-box {
    background: #f7f9f6;
    border: 1px solid #d4ded3;
    border-left: 4px solid #2d6a4f;
    border-radius: 6px;
    padding: 24px;
    margin: 32px 0 44px;
  }
  .direct-answer-header {
    margin-bottom: 12px;
  }
  .direct-answer-badge {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #2d6a4f;
  }
  .direct-answer-text {
    font-size: 17px;
    line-height: 1.6;
    color: #1a2e22;
    margin-bottom: 20px;
  }
  .direct-answer-specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid #e1e8df;
  }
  .spec-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .spec-label {
    font-size: 12px;
