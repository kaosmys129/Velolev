const renderedCards = new Set();
const fm = figureMap[locale] || figureMap.en;

function getSectionFigure(heading, folder) {
  if (!folder) return null;
  const h = heading.trim();

  // 1. 对比决策矩阵 (Section 1)
  if (!renderedCards.has("05") && (h.startsWith("1.") || /engineering challenge.*crane|arquitectura mecánica|desafío|défi|desafio|thách thức|ความท้าทาย|tantangan/i.test(h))) {
    renderedCards.add("05");
    return {
      id: "05",
      src: `/images/${folder}/05-crane-vs-lifter-comparison-16x9.png`,
      alt: fm.fig5Alt,
      label: fm.fig5Label,
      caption: fm.fig5Caption
    };
  }

  // 2. 双模组分体机械架构 (Section 2)
  if (!renderedCards.has("02") && (h.startsWith("2.") || /hydraulic mechanics.*300kg|mechanical architecture|seguridad|mecánica hidráulica|mécanique|mecânica|thủy lực|กลไกไฮดรอลิก|mekanika/i.test(h))) {
    renderedCards.add("02");
    return {
      id: "02",
      src: `/images/${folder}/02-two-module-architecture-16x9.png`,
      alt: fm.fig2Alt,
      label: fm.fig2Label,
      caption: fm.fig2Caption
    };
  }

  // 3. 底板法兰 P.C.D. 适配图 (Section 3)
  if (!renderedCards.has("03") && (h.startsWith("3.") || /foundation anchorage.*p\\.?c\\.?d|compatibilidad de bridas|cimentación|massif|fundação|móng|ฐานราก|pondasi/i.test(h))) {
    renderedCards.add("03");
    return {
      id: "03",
      src: `/images/${folder}/03-flange-pcd-compatibility-16x9.png`,
      alt: fm.fig3Alt,
      label: fm.fig3Label,
      caption: fm.fig3Caption
    };
  }

  // 4. 标准 SOP 施工工序图 (Section 4)
  if (!renderedCards.has("04") && (h.startsWith("4.") || /standard sop erection sequence|sop workflow|procedimiento operativo|procédure|procedimento|quy trình|ขั้นตอน|prosedur/i.test(h))) {
    renderedCards.add("04");
    return {
      id: "04",
      src: `/images/${folder}/04-sop-field-workflow-16x9.png`,
      alt: fm.fig4Alt,
      label: fm.fig4Label,
      caption: fm.fig4Caption
    };
  }

  return null;
}

// 识别是否是子章节（Phase 1/2/3 或常见问答）
function isSubHeading(heading) {
  const h = heading.trim();
  return /^(?:Phase \d|Fase \d|Étape \d|Giai đoạn \d|ขั้นตอนที่ \d|Tahap \d|\?|What |Can |Does |How |¿|Est-ce |Peut-on |Quel |Comment |É |Como |O |Có |เสา |Apakah |Bagaimana )/i.test(h) || h.endsWith("?") || h.endsWith("？");
}

