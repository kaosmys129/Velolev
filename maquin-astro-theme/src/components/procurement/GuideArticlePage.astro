  },
  id: {
    directAnswerBadge: "Ringkasan Spesifikasi / Ruang Lingkup Tinjauan",
    directAnswerText: "Tiang lampu jalan kelas 12 m dalam batas beban terukur 300 kg dapat dievaluasi untuk pemasangan tanpa derek menggunakan alat angkat tiang hidrolik portabel yang ditambatkan pada baut pondasi. Kesesuaian wajib dikonfirmasi berdasarkan berat rakitan total, titik pusat gravitasi, geometri flensa, kondisi pondasi, dan jarak bebas udara.",
    specLabelLimit: "Beban Terukur",
    specCapacity: "300 kg (Kelas hingga 12 m)",
