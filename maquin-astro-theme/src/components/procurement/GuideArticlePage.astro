const renderedCards = new Set();
const fm = figureMap[locale] || figureMap.en;

function getSectionFigure(heading, folder) {
  if (!folder) return null;
  const h = heading.trim();
  const folderPath = path.join(publicBase, folder);

  // 1. 对比决策矩阵 (Section 1)
  if (!renderedCards.has("05") && (h.startsWith("1.") || /site access|engineering challenge|desafío|acceso a obra|défi|accès chantier|desafio|acesso à obra|thách thức|tiếp cận|ความท้าทาย|การเข้าถึง|tantangan|akses lokasi/i.test(h))) {
    if (fs.existsSync(path.join(folderPath, "05-crane-vs-lifter-comparison-16x9.png"))) {
      renderedCards.add("05");
      return {
        id: "05",
        src: `/images/${folder}/05-crane-vs-lifter-comparison-16x9.png`,
        alt: fm.fig5Alt,
        label: fm.fig5Label,
        caption: fm.fig5Caption
      };
    }
  }

  // 2. 双模组分体机械架构 (Section 2)
  if (!renderedCards.has("02") && (h.startsWith("2.") || /two-module|hydraulic mechanics|arquitectura hidráulica|mecánica|architecture hydraulique|mécanique|arquitetura hidráulica|mecânica|kiến trúc thủy lực|thủy lực|สถาปัตยกรรมไฮดรอลิก|กลไก|arsitektur hidrolik|mekanika/i.test(h))) {
    if (fs.existsSync(path.join(folderPath, "02-two-module-architecture-16x9.png"))) {
      renderedCards.add("02");
      return {
        id: "02",
        src: `/images/${folder}/02-two-module-architecture-16x9.png`,
        alt: fm.fig2Alt,
        label: fm.fig2Label,
        caption: fm.fig2Caption
      };
    }
  }

  // 3. 底板法兰与地脚螺栓适配图 (Section 3)
  if (!renderedCards.has("03") && (h.startsWith("3.") || /base flange|foundation anchorage|rango de brida|cimentación|entraxe de platine|massif|vão da flange|fundação|khoảng lỗ mặt bích|móng|ระยะรูหน้าแปลน|ฐานราก|bentang flensa|pondasi/i.test(h))) {
    if (fs.existsSync(path.join(folderPath, "03-flange-pcd-compatibility-16x9.png"))) {
      renderedCards.add("03");
      return {
        id: "03",
        src: `/images/${folder}/03-flange-pcd-compatibility-16x9.png`,
        alt: fm.fig3Alt,
        label: fm.fig3Label,
        caption: fm.fig3Caption
      };
    }
  }

  // 4. 安装前工程核查图 (Section 4)
  if (!renderedCards.has("04") && (h.startsWith("4.") || /pre-installation|standard sop|verificaciones previas|procedimiento|contrôles d'ingénierie|procédure|verificações prévias|procedimento|kiểm tra kỹ thuật|quy trình|การตรวจสอบทางวิศวกรรม|ขั้นตอน|pemeriksaan teknik|prosedur/i.test(h))) {
    if (fs.existsSync(path.join(folderPath, "04-sop-field-workflow-16x9.png"))) {
      renderedCards.add("04");
      return {
        id: "04",
        src: `/images/${folder}/04-sop-field-workflow-16x9.png`,
        alt: fm.fig4Alt,
        label: fm.fig4Label,
        caption: fm.fig4Caption
      };
    }
  }

  return null;
}

// 识别是否是子章节（预检阶段或常见问答）
function isSubHeading(heading) {
  const h = heading.trim();
  return /^(?:Pre-Lift|Equipment Connection|Controlled Lift|Verificación previa|Conexión del equipo|Elevación controlada|Vérification préalable|Raccordement|Levage contrôlé|Verificação prévia|Conexão do equipamento|Elevação controlada|Kiểm tra móng|Kết nối thiết bị|Nâng có kiểm soát|การตรวจสอบฐานราก|การเชื่อมต่ออุปกรณ์|การยกแบบควบคุม|Pemeriksaan Pondasi|Penyambungan Peralatan|Pengangkatan Terkendali|Phase \d|Fase \d|Étape \d|Giai đoạn \d|ขั้นตอนที่ \d|Tahap \d|\?|What |Can |Does |How |Which |¿|Est-ce |Peut-on |Quel |Quelles |Combien |Comment |É |Como |O |Quais |Quantos |Có |Giới hạn |Bảng thông số |Những bu-lông |Thiết bị |เสา |พิกัด |เอกสารสเปก |สลักยึด |อุปกรณ์ |Apakah |Bagaimana |Berapa |Baut angkur )/i.test(h) || h.endsWith("?") || h.endsWith("？");
}

// 多语言文案字典（严格遵循 S4 规格基线）
const copyMap = {
