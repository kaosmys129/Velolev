---
import {aboutFor} from "../../lib/about-content.mjs";
const {locale="en"}=Astro.props;
const copy=aboutFor(locale),current=copy.locale;
import FactoryTourGallery from "./FactoryTourGallery.astro";
import QualityTestingStrip from "./QualityTestingStrip.astro";
import MilestoneTimeline from "./MilestoneTimeline.astro";
import TeamGrid from "./TeamGrid.astro";
const logisticsCopy=copy.ui;
const quotePath=current==="en"?"/quote/":`/${current}/contact-us/`;
---

<main id="main" class="about-page-main" data-about-source="S4" data-field-validation={copy.fieldValidation} data-corporate-evidence={copy.corporateEvidence}>
  <!-- 1. Hero 头部权威背书与四大核心指标带 -->
  <section class="about-hero">
    <div class="wrap">
      <div class="hero-content">
        <div class="hero-badge-row">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <span class="oem-entity-badge">VERIFIED OEM MANUFACTURER</span>
        </div>
        <h1 class="hero-title">{copy.hero.title}</h1>
        <p class="lead hero-lead muted">{copy.hero.subtitle}</p>
      </div>

      <div class="stats-grid">
        {copy.hero.stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-top">
              <span class="stat-num">{stat.value}</span>
              <span class="stat-unit">{stat.unit}</span>
            </div>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. 工厂制造与加工能力画廊 -->
  <FactoryTourGallery locale={current} />

  <!-- 3. 市政照明免吊车工程演进时间线 -->
  <MilestoneTimeline locale={current} />

  <!-- 4. 实体质量保证体系与300kg测试台全检 -->
  <QualityTestingStrip locale={current} />

  <!-- 5. 机械工程技术团队与非标定制支持 -->
  <TeamGrid locale={current} />

  <!-- 6. 全球港口直发与交付合作网络 -->
  <section class="global-logistics-section" id="global-logistics">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{copy.global.eyebrow}</p>
          <h2>{copy.global.title}</h2>
        </div>
        <p class="muted">{copy.global.lead}</p>
      </div>

      <div class="logistics-grid">
        <div class="ports-container">
          <div class="port-subhead">
            <span class="hub-tag">{logisticsCopy.portsTag}</span>
            <h3>{logisticsCopy.portsTitle}</h3>
          </div>
          <div class="ports-list">
            {copy.global.ports.map((port) => (
              <div class="port-item">
                <div class="port-marker">⚓</div>
                <div>
                  <h4 class="port-name">{port.name}</h4>
                  <p class="port-desc muted">{port.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="terms-container">
          <div class="terms-subhead">
            <span class="hub-tag">{logisticsCopy.termsTag}</span>
            <h3>{logisticsCopy.termsTitle}</h3>
          </div>
          <div class="terms-badges">
            {copy.global.terms.map((term) => (
              <span class="term-badge">{term}</span>
            ))}
          </div>
          <div class="ecosystem-box">
            <p class="ecosystem-title">{logisticsCopy.ecosystemTitle}</p>
            <p class="ecosystem-text muted">{copy.global.ecosystem}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. B2B 私下询价与图纸保密行动横幅 -->
  <section class="cta-banner-section">
    <div class="wrap">
      <div class="cta-banner-box">
        <div class="cta-copy">
          <p class="eyebrow" style="color:var(--ink)">{logisticsCopy.ctaEyebrow}</p>
          <h2>{copy.cta.title}</h2>
          <p class="lead" style="color:rgba(29,32,30,0.85); margin-top:16px;">{copy.cta.lead}</p>
          <div class="cta-actions">
            <a class="button button-dark" href={quotePath}>
              {copy.cta.button} <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="confidentiality-note">
            <span class="lock-icon" aria-hidden="true">🔒</span>
            {copy.cta.note}
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<style>
  .about-page-main {
    min-width: 0;
    max-width: 100%;
    overflow-x: hidden;
  }

  /* Hero Section */
  .about-hero {
    padding: 70px 0 60px 0;
    background: var(--paper);
  }

  .hero-content {
    max-width: 900px;
    margin-bottom: 45px;
  }

  .hero-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .oem-entity-badge {
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: #edf1e8;
    color: #2b571e;
    border: 1px solid #c2dbb5;
    padding: 3px 8px;
    border-radius: 2px;
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(34px, 4.8vw, 62px);
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin: 16px 0 20px 0;
    overflow-wrap: anywhere;
  }

  .hero-lead {
    font-size: 18px;
    line-height: 1.65;
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .stat-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    max-width: 100%;
    border-left: 3px solid var(--yellow);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .stat-card:hover {
    border-color: var(--yellow);
    transform: translateY(-2px);
  }

  .stat-top {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .stat-num {
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 30px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1;
  }

  .stat-unit {
    font-size: 12px;
    color: var(--muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .stat-label {
    font-size: 13px;
    color: var(--ink);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  /* Section Head */
  .section-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 50px;
  }

  /* Global Logistics Section */
  .global-logistics-section {
    padding: 90px 0;
    background: #ffffff;
    border-bottom: 1px solid var(--line);
  }

  .logistics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .ports-container, .terms-container {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
  }

  .hub-tag {
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
    display: block;
    margin-bottom: 6px;
  }

  .port-subhead h3, .terms-subhead h3 {
    font-size: 20px;
    font-weight: 650;
    color: var(--ink);
    margin: 0 0 24px 0;
    overflow-wrap: anywhere;
  }

  .ports-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .port-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: var(--white);
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 2px;
  }

  .port-marker {
    font-size: 20px;
    line-height: 1;
    color: var(--muted);
  }

  .port-name {
    font-size: 16px;
    font-weight: 650;
    color: var(--ink);
    margin: 0 0 6px 0;
  }

  .port-desc {
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }

  .terms-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .term-badge {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 8px 14px;
    border-radius: 2px;
    font-family: 'Courier New', SFMono-Regular, monospace;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    border-left: 3px solid var(--yellow);
  }

  .ecosystem-box {
    background: var(--white);
    border: 1px solid var(--line);
    padding: 20px;
    border-radius: 2px;
    margin-top: auto;
  }

  .ecosystem-title {
    font-size: 14px;
    font-weight: 650;
    color: var(--ink);
    margin: 0 0 8px 0;
  }

  .ecosystem-text {
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
  }

  /* CTA Banner Section */
  .cta-banner-section {
    padding: 80px 0;
    background: var(--paper);
  }

  .cta-banner-box {
    background: var(--yellow);
    border: 1px solid #d4ae24;
    border-radius: 2px;
    padding: 50px 48px;
    color: var(--ink);
  }

  .cta-copy {
    max-width: 820px;
  }

  .cta-copy h2 {
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 650;
    line-height: 1.15;
    margin: 12px 0 0 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .cta-actions {
    margin-top: 30px;
  }

  .button-dark {
    background: var(--ink);
    color: var(--white);
    display: inline-block;
    padding: 17px 28px;
    font-weight: 600;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .button-dark:hover {
    background: #000000;
    transform: translateY(-2px);
  }

  .confidentiality-note {
    font-size: 13px;
    color: rgba(29, 32, 30, 0.85);
    margin: 20px 0 0 0;
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-wrap: anywhere;
  }

  .lock-icon {
    font-size: 14px;
  }

  /* Responsive Rules */
  @media (max-width: 1050px) {
    .section-head {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .logistics-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .cta-banner-box {
      padding: 36px 30px;
    }
  }

  @media (max-width: 760px) {
    .about-hero {
      padding: 50px 0 40px 0;
    }

    .global-logistics-section {
      padding: 55px 0;
    }

    .cta-banner-section {
      padding: 50px 0;
    }

    .stats-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ports-container, .terms-container {
      padding: 24px 18px;
    }

    .cta-banner-box {
      padding: 28px 20px;
    }

    .button-dark {
      width: 100%;
      text-align: center;
    }
  }
</style>
