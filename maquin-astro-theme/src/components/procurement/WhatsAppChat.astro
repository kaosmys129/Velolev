<script define:vars={{ cleanPhone }}>
  (function initWhatsAppChat() {
    const root = document.querySelector('[data-wa-root]');
    if (!root) return;

    const triggerBtn = root.querySelector('[data-wa-trigger]');
    const panel = root.querySelector('[data-wa-panel]');
    const closeBtn = root.querySelector('[data-wa-close]');
    const teaser = root.querySelector('[data-wa-teaser]');
    const teaserDismiss = root.querySelector('[data-wa-teaser-dismiss]');
    const form = root.querySelector('[data-wa-form]');
    const textInput = root.querySelector('[data-wa-input]');
    const quickTags = root.querySelectorAll('[data-wa-quick-text]');
    const nowElement = root.querySelector('[data-wa-now]');

    // 格式化当前时间为 HH:MM
    if (nowElement) {
      try {
        const d = new Date();
        nowElement.textContent = d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0');
      } catch (e) {}
    }

    // 检查 sessionStorage 记忆气泡关闭状态
    const TEASER_STORAGE_KEY = 'velolev_wa_teaser_dismissed';
    try {
      if (sessionStorage.getItem(TEASER_STORAGE_KEY) === 'true' && teaser) {
        teaser.classList.add('is-hidden');
      }
    } catch (e) {}

    // 关闭引导气泡
    teaserDismiss?.addEventListener('click', (e) => {
      e.stopPropagation();
      teaser?.classList.add('is-hidden');
      try {
        sessionStorage.setItem(TEASER_STORAGE_KEY, 'true');
      } catch (e) {}
    });

    // 切换面板展开/收起
    function setOpen(isOpen) {
      root.classList.toggle('is-open', isOpen);
      triggerBtn?.setAttribute('aria-expanded', String(isOpen));
      panel?.setAttribute('aria-hidden', String(!isOpen));
      if (isOpen) {
        teaser?.classList.add('is-hidden');
        // 自动将焦点移至输入框
        setTimeout(() => textInput?.focus(), 150);
      }
    }

    triggerBtn?.addEventListener('click', () => {
      const isOpen = root.classList.contains('is-open');
      setOpen(!isOpen);
    });

    closeBtn?.addEventListener('click', () => {
      setOpen(false);
      triggerBtn?.focus();
    });

    // 点击外部区域自动收起
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) {
        if (root.classList.contains('is-open')) {
          setOpen(false);
        }
      }
    });

    // ESC 快捷键关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        setOpen(false);
        triggerBtn?.focus();
      }
    });

    // 快捷标签点击：更新输入框内容并提供视觉反馈
    quickTags.forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-wa-quick-text') || '';
        if (textInput) {
          textInput.value = text;
          textInput.focus();
        }
      });
    });

    // 提交直接跳转 WhatsApp
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const message = textInput?.value?.trim() || '';
      const targetUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;

      // 触发外发事件供分析监测（如 GA4 / 统计）
      try {
        document.dispatchEvent(new CustomEvent('velolev:whatsapp-inquiry', {
          detail: {
            phone: cleanPhone,
            message: message,
            page: window.location.pathname
          }
        }));
      } catch (err) {}

      // 打开 WhatsApp 对话
      window.open(targetUrl, '_blank', 'noopener,noreferrer');
    });
  })();
</script>
