---
/**
 * WhatsAppChat.astro - WhatsApp 在线快捷咨询悬浮组件
 * 
 * 专为海外 B2B 工业装备独立站设计，支持多语言适配、多预设问题快捷选择、
 * 官方 WhatsApp 绿意品牌动效与移动端自适应防遮挡布局。
 */
interface Props {
  /** 页面语言代码: en | es | fr | pt | vi | th | id */
  locale?: string;
  /** WhatsApp 国际格式号码，如 "+86 138 0000 0000" 或 "8613800000000" */
  phoneNumber?: string;
  /** 客服/技术支持顾问名称 */
  agentName?: string;
  /** 客服职务/业务线说明 */
  agentRole?: string;
  /** 企业/品牌名称 */
  companyName?: string;
  /** 默认初始预填消息（可选，若未指定则采用各语言预设模板） */
  defaultMessage?: string;
  /** 快捷问题列表覆盖（可选） */
  quickQuestions?: string[];
}

const {
  locale = "en",
  phoneNumber = (typeof process !== "undefined" && process.env?.PUBLIC_WHATSAPP_NUMBER) || "+86 138 0000 0000",
  agentName: customAgentName,
  agentRole = "Pole Installation Specialist",
  companyName = "velolev",
  defaultMessage,
  quickQuestions: customQuestions
} = Astro.props;

// 清洗电话号码，仅保留数字
const cleanPhone = phoneNumber.replace(/[^0-9]/g, "");

// 多语言文案字典
const i18nDictionary: Record<string, {
  tooltip: string;
  dismissTooltip: string;
  badgeText: string;
  unreadBadge: string;
  statusOnline: string;
  typicalReply: string;
  welcomeGreeting: string;
  quickTitle: string;
  questions: string[];
  inputPlaceholder: string;
  inputLabel: string;
  sendAction: string;
  footerNote: string;
  closeLabel: string;
  openLabel: string;
  defaultMsg: string;
  agentName: string;
  teamName: string;
  today: string;
  now: string;
}> = {
  en: {
    tooltip: "Need help? Chat with us",
    dismissTooltip: "Dismiss tooltip",
    badgeText: "1",
    unreadBadge: "1 unread alert",
    statusOnline: "Online",
    typicalReply: "Replies in ~15 mins",
    welcomeGreeting: "Hello! 👋 Welcome to velolev. How can we assist with your light pole installation or equipment procurement today?",
    quickTitle: "Quick inquiry topics:",
    questions: [
      "I'd like to request a quotation for the portable pole lifter.",
      "Can you help verify our pole and foundation flange compatibility?",
      "What is the lead time, packing dimensions and shipping availability?",
      "Could you share the technical specification sheet and operator manual?"
    ],
    inputPlaceholder: "Type your inquiry or choose a topic above...",
    inputLabel: "Your inquiry message",
    sendAction: "Start WhatsApp Chat",
    footerNote: "Official WhatsApp Business · Direct Specialist Support",
    closeLabel: "Close WhatsApp chat panel",
    openLabel: "Open WhatsApp online consultation",
    defaultMsg: "Hello, I am interested in the velolev Portable Light Pole Lifter. Please provide more procurement details.",
    agentName: "velolev Technical Support",
    teamName: "velolev Team",
    today: "Today",
    now: "Now"
  },
  es: {
    tooltip: "¿Necesitas ayuda? Chatea con nosotros",
    dismissTooltip: "Descartar aviso",
    badgeText: "1",
    unreadBadge: "1 alerta no leída",
    statusOnline: "En línea",
    typicalReply: "Responde en ~15 min",
