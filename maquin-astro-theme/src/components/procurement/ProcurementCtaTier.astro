---
import {localizedDocumentPath} from '../../lib/localized-documents.mjs';
interface Props {locale?:string;mode?:'banner'|'compact'|'cards';highlightTier?:1|2|3;class?:string;}
const {locale='en',mode='cards',highlightTier=1,class:className=''}=Astro.props;
const paths=[
 {tier:2,step:'01',title:'Explore the specifications',body:'Download the dimensions, module weights and included components for your project comparison.',href:localizedDocumentPath('velolev-specifications.csv',locale),label:'Download CSV ↓',download:true},
 {tier:3,step:'02',title:'Review your base connection',body:'Check the flange dimensions, then share your drawing and project details for a configuration review.',href:'/guides/pole-jack-compatibility/#flange-instant-checker',label:'Check compatibility →'},
 {tier:1,step:'03',title:'Request a project quote',body:'Send the application, quantity and destination. Start with the information you have; drawings are optional.',href:'/quote/',label:'Request a project quote',download:false}
];
---
<section class:list={['procurement-cta-tier',`mode-${mode}`,className]} aria-label="Plan your next step">
  <div class="section-head"><div><p class="eyebrow">Your project / Next steps</p><h2>From first look<br/>to project quote.</h2></div><p class="muted">Choose the next step that fits your project. Explore the equipment, check your connection or discuss a quotation.</p></div>
  <div class="procurement-paths">{paths.map(path=><article class:list={['procurement-path',{'is-highlighted':path.tier===highlightTier}]}><span class="section-number">{path.step}</span><h3>{path.title}</h3><p class="muted">{path.body}</p><a class={path.tier===highlightTier?'button':'text-link'} href={path.href} download={path.download||undefined}>{path.label}{path.tier===1&&<span aria-hidden="true">↗</span>}</a></article>)}</div>
</section>
<style>
.procurement-cta-tier{border-top:1px solid var(--line);padding-top:45px}.procurement-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.procurement-path{padding:30px;display:flex;flex-direction:column;align-items:start;border-right:1px solid var(--line);min-width:0;gap:22px}.procurement-path:first-child{padding-left:0}.procurement-path:last-child{border-right:0}.procurement-path .section-number{margin:0}.procurement-path h3{line-height:1.25}.procurement-path p{font-size:14px;line-height:1.7;flex:1}.procurement-path a{font-size:13px;gap:18px;max-width:100%;margin-top:6px;overflow-wrap:anywhere}.procurement-path.is-highlighted{background:var(--white);border-top:3px solid var(--yellow);padding-top:27px}.procurement-path:first-child.is-highlighted{padding-left:30px}.mode-compact .section-head,.mode-banner .section-head{margin-bottom:28px}.mode-compact h2,.mode-banner h2{font-size:clamp(28px,3vw,38px)}
@media(max-width:1050px){.procurement-path{padding:25px 20px}.procurement-path.is-highlighted{padding-top:22px}}@media(max-width:760px){.procurement-cta-tier{padding-top:32px}.procurement-paths{grid-template-columns:1fr}.procurement-path,.procurement-path:first-child{border-right:0;border-bottom:1px solid var(--line);padding:28px 0;gap:18px}.procurement-path:last-child{border-bottom:0}.procurement-path.is-highlighted,.procurement-path:first-child.is-highlighted{padding:28px 24px;border-top:3px solid var(--yellow)}}
</style>
