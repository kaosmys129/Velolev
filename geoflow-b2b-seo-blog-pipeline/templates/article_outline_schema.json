{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArticleOutlineTree",
  "description": "GEOFlow B2B 渐进式大纲树与事实台账绑定规范",
  "type": "object",
  "required": [
    "title",
    "slug",
    "language",
    "reading_level",
    "target_audience",
    "sections",
    "faq",
    "evidence_refs"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "拟定文章主标题"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "规范化 URL 路径标识"
    },
    "language": {
      "type": "string",
      "enum": ["en", "es", "fr", "pt", "id", "th", "vi"],
      "default": "en"
    },
    "reading_level": {
      "type": "string",
      "description": "目标受众阅读难度（如 Grade 8-10）"
    },
    "target_audience": {
      "type": "string",
      "description": "受众工程师/采购经理角色定位"
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["heading", "focus_points", "bound_facts", "cta_type"],
        "properties": {
          "heading": {
            "type": "string",
            "description": "H2 小节标题"
          },
          "focus_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "本小节核心论点与工法说明"
          },
          "bound_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F0(?:0[1-9]|[12][0-9]|3[01])$"
            },
            "description": "绑定的原子事实台账编号 (F001-F031)"
          },
          "cta_type": {
            "type": "string",
            "enum": ["none", "top", "mid", "bottom"],
            "description": "本章节拟植入的转化漏斗阶段"
          },
          "standards": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "本章节拟引述的工程规范 (如 OSHA 1926, ASTM F1554)"
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["question", "answer_key_fact"],
        "properties": {
          "question": {
            "type": "string",
            "description": "买家常见疑问（来自 PAA）"
          },
          "answer_key_fact": {
            "type": "string",
            "description": "解答必须包含的客观工程事实"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^F0(?:0[1-9]|[12][0-9]|3[01])$"
      },
      "description": "全文引用的事实编号汇总"
    }
  }
}
