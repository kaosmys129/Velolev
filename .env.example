# ==============================================================================
# volvet 工业机械 - 邮件与询盘系统环境变量配置模板
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Resend Email 服务配置 (核心)
# ------------------------------------------------------------------------------
# 在 https://resend.com/api-keys 获取 API 密钥
# 测试阶段若为空，系统将自动进入 Mock 模拟模式，控制台打印发信日志且不中断任何业务流程
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# 发件人地址 (生产环境必须在 Resend 验证自有域名，例如 velolev.org)
# 测试沙箱环境可使用 Resend 官方默认测试发件人: volvet <onboarding@resend.dev>
RESEND_FROM_EMAIL=volvet Procurement <notifications@velolev.org>

# 内部管理员 / 业务团队接收新询盘通知的邮箱 (接收客户项目规格、图纸附件与采购需求)
ADMIN_NOTIFICATION_EMAIL=sales@velolev.org

# 客户回复邮件时的回信地址 (Reply-To)
RESEND_REPLY_TO=support@velolev.org

# (可选) Resend Audience 受众列表 ID，配置后网站新增订阅者会自动同步到 Resend Contacts
# 在 Resend 控制台 -> Audiences 中创建或查看 ID
RESEND_AUDIENCE_ID=

# ------------------------------------------------------------------------------
# 2. 站点与询盘服务器配置
# ------------------------------------------------------------------------------
# 公网主域名 (用于生成邮件内的绝对链接与退订跳转)
PUBLIC_ORIGIN=https://www.velolev.org

# 询盘服务监听主机与端口
INQUIRY_HOST=127.0.0.1
INQUIRY_PORT=8787

# 私有数据存储目录 (必须置于公开站点目录之外，存放 SQLite 数据库与附件)
INQUIRY_DATA_DIR=.local/inquiries

# 管理员访问私有收件箱与订阅者名单的私有密钥 (生产环境建议至少 32 字符随机字符串)
# 若留空，本地服务启动时会自动生成并保存在 .local/inquiries/admin-token 中
INQUIRY_ADMIN_TOKEN=

# 测试模式开关 (设为 true 时所有提交标记为测试记录，不计入正式商务统计)
INQUIRY_TEST_MODE=false
