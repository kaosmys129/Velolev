        "lineHeight": "1.15",
        "letterSpacing": "-0.03em",
        "weight": 650
      },
      "h3": {
        "size": "23px",
        "lineHeight": "1.25",
        "letterSpacing": "-0.025em",
        "weight": 650
      },
      "lead": {
        "size": "18px",
        "lineHeight": "1.7",
        "weight": 400
      },
      "body": {
        "size": "15px",
        "lineHeight": "1.65",
        "weight": 400
      },
      "small": {
        "size": "13px",
        "lineHeight": "1.5",
        "weight": 400
      },
      "caption": {
        "size": "11px",
        "lineHeight": "1.4",
        "letterSpacing": "0.16em",
        "weight": 650,
        "textTransform": "uppercase"
      },
      "specNumber": {
        "size": "36px",
        "lineHeight": "1.2",
        "letterSpacing": "-0.05em",
        "weight": 650
      }
